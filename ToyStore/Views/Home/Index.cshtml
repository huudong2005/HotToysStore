@model IEnumerable<ToyStore.Domain.Entities.Category>
@{
    ViewData["Title"] = "Trang chủ";
    var user = ViewBag.User as ToyStore.Models.UserSession;

    // Hero Carousel động: lấy danh sách banner đang active từ DB (ViewBag.ActiveBanners)
    var activeBanners = (ViewBag.ActiveBanners as IEnumerable<ToyStore.Domain.Entities.Banner>)?.ToList()
        ?? new List<ToyStore.Domain.Entities.Banner>();
    const string defaultHeroImage = "https://images.unsplash.com/photo-1608889825103-eb5ed706fc64?q=80&w=1920&auto=format&fit=crop";
}

<div class="home-page">
    <!-- ===== Cinematic Hero Carousel (ảnh nền trượt tự động, lấy động từ DB) ===== -->
    <section class="cinematic-hero">
        <!-- Lớp ảnh nền: Carousel chạy phía sau (z-index thấp) -->
        <div id="heroCarousel" class="carousel slide carousel-fade cinematic-hero__bg"
             data-bs-ride="carousel" data-bs-interval="4000" data-bs-pause="false">
            <div class="carousel-inner">
                @if (activeBanners.Any())
                {
                    @for (int i = 0; i < activeBanners.Count; i++)
                    {
                        var banner = activeBanners[i];
                        var img = !string.IsNullOrWhiteSpace(banner.ImagePath) ? banner.ImagePath : defaultHeroImage;
                        <div class="carousel-item @(i == 0 ? "active" : "")" data-bs-interval="4000">
                            <div class="cinematic-hero__slide" style="background-image: url('@img');"></div>
                            <div class="cinematic-hero__overlay"></div>
                        </div>
                    }
                }
                else
                {
                    <!-- Fallback: không có banner active -> ảnh mặc định để không vỡ layout -->
                    <div class="carousel-item active">
                        <div class="cinematic-hero__slide" style="background-image: url('@defaultHeroImage');"></div>
                        <div class="cinematic-hero__overlay"></div>
                    </div>
                }
            </div>

            @if (activeBanners.Count > 1)
            {
                <div class="carousel-indicators cinematic-hero__indicators">
                    @for (int i = 0; i < activeBanners.Count; i++)
                    {
                        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="@i"
                                class="@(i == 0 ? "active" : "")" aria-label="Banner @(i + 1)"></button>
                    }
                </div>
            }
        </div>

        <!-- Lớp nội dung: đứng im tuyệt đối ở giữa, không trượt theo ảnh (z-index cao) -->
        <div class="cinematic-hero__content d-flex align-items-center justify-content-center">
            <div class="cinematic-hero__inner">
                <p class="cinematic-hero__eyebrow">Premium Figure Collection</p>
                <h1 class="cinematic-hero__title">Chào mừng đến với <span>ToyStore</span></h1>
                <p class="cinematic-hero__subtitle">
                    Khám phá bộ sưu tập mô hình và đồ chơi độc đáo, cập nhật mỗi ngày.
                </p>

                <!-- Search Bar (giữ nguyên logic: GET /Home, field "searchName") -->
                <form method="get" action="/Home" class="cinematic-hero__search">
                    <input type="text" name="searchName" value="@ViewBag.SearchName"
                           class="cinematic-hero__input" placeholder="Tìm kiếm sản phẩm..." autocomplete="off" />
                    <button type="submit" class="cinematic-hero__btn">
                        <i class="fas fa-search me-2"></i>Tìm kiếm
                    </button>
                    @if (!string.IsNullOrEmpty((string)ViewBag.SearchName))
                    {
                        <a href="/Home" class="cinematic-hero__clear" title="Xóa tìm kiếm">
                            <i class="fas fa-times"></i>
                        </a>
                    }
                </form>

                <!-- Welcome Message -->
                @if (user != null)
                {
                    <p class="cinematic-hero__welcome">
                        <i class="fas fa-user-circle me-2"></i>Xin chào, <strong>@user.FullName</strong> — @user.UserType
                    </p>
                }
                else
                {
                    <p class="cinematic-hero__welcome">
                        Hãy <a asp-controller="Auth" asp-action="Login">đăng nhập</a>
                        hoặc <a asp-controller="Auth" asp-action="Register">đăng ký</a> để trải nghiệm đầy đủ.
                    </p>
                }
            </div>
        </div>

        <a href="#featured" class="cinematic-hero__scroll" aria-label="Cuộn xuống">
            <i class="fas fa-chevron-down"></i>
        </a>
    </section>

    <div class="toast-notification-container"></div>

    <!-- ===== Bộ sưu tập nổi bật (Featured Collections) ===== -->
    <section id="featured" class="featured-section container">
        <div class="text-center featured-section__head">
            <p class="featured-section__eyebrow">New Arrivals</p>
            <h2 class="featured-section__title">Sản phẩm nổi bật</h2>
            <span class="lux-divider"></span>
        </div>

        @{
            var fallbackImages = new[]
            {
                "https://images.unsplash.com/photo-1608889825103-eb5ed706fc64?q=80&w=1200&auto=format&fit=crop",
                "https://images.unsplash.com/photo-1606503153255-59d8b8b82176?q=80&w=1200&auto=format&fit=crop",
                "https://images.unsplash.com/photo-1518331647614-7a1f04cd34cf?q=80&w=1200&auto=format&fit=crop"
            };
            var featured = (Model ?? Enumerable.Empty<ToyStore.Domain.Entities.Category>()).Take(3).ToList();
        }

        <div class="row g-4">
            @if (featured.Any())
            {
                @for (int i = 0; i < featured.Count; i++)
                {
                    var cat = featured[i];
                    var prodImg = cat.Products?.FirstOrDefault(p => !string.IsNullOrEmpty(p.ImageUrl))?.ImageUrl;
                    var img = !string.IsNullOrEmpty(prodImg) ? prodImg : fallbackImages[i % fallbackImages.Length];
                    <div class="col-md-4">
                        <a class="collection-card" href="/Home/Shop?categoryId=@cat.CategoryId">
                            <img src="@img" alt="@cat.CategoryName" class="collection-card__img" />
                            <div class="collection-card__overlay">
                                <span class="collection-card__label">Bộ sưu tập</span>
                                <h3 class="collection-card__title">@cat.CategoryName</h3>
                                <span class="collection-card__count">@(cat.Products?.Count() ?? 0) sản phẩm</span>
                            </div>
                        </a>
                    </div>
                }
            }
            else
            {
                @for (int i = 0; i < 3; i++)
                {
                    <div class="col-md-4">
                        <a class="collection-card" href="/Home/Shop">
                            <img src="@fallbackImages[i]" alt="Bộ sưu tập ToyStore" class="collection-card__img" />
                            <div class="collection-card__overlay">
                                <span class="collection-card__label">Bộ sưu tập</span>
                                <h3 class="collection-card__title">Khám phá ngay</h3>
                            </div>
                        </a>
                    </div>
                }
            }
        </div>
    </section>

    <!-- Section hiển thị sản phẩm theo danh mục -->
    <div class="container mt-5">
        <h2 class="mb-4">Sản phẩm theo danh mục</h2>
        @if (Model != null && Model.Any())
        {
            @foreach (var category in Model)
            {
                <div class="mb-5">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h3 class="text-primary">
                            <i class="fas fa-tags me-2"></i>@category.CategoryName
                        </h3>
                        <a asp-controller="Home" asp-action="Shop" class="btn btn-outline-primary btn-sm">
                            Xem tất cả <i class="fas fa-arrow-right ms-1"></i>
                        </a>
                    </div>
                    
                    @if (category.Products.Any())
                    {
                        <div class="row g-4 product-grid">
                            @foreach (var product in category.Products.Take(6))
                            {
                                <div class="col-sm-6 col-md-4 col-lg-3">
                                    <div class="card h-100 product-card" style="cursor: pointer;" onclick="location.href='@Url.Action("ProductDetails", "Home", new { id = product.ProductId })'">
                                        <div class="product-card__image-wrap position-relative">
                                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                                            {
                                                <img src="@product.ImageUrl" class="card-img-top product-card__img" alt="@product.ProductName">
                                            }
                                            else
                                            {
                                                <div class="card-img-top product-card__img product-card__img--placeholder d-flex align-items-center justify-content-center">
                                                    <i class="fas fa-image fa-3x text-muted"></i>
                                                </div>
                                            }
                                            @if (product.Stock == 0)
                                            {
                                                <div class="position-absolute top-0 end-0 m-2">
                                                    <span class="badge product-card__badge product-card__badge--danger">Hết hàng</span>
                                                </div>
                                            }
                                            else if (product.Stock <= 5)
                                            {
                                                <div class="position-absolute top-0 end-0 m-2">
                                                    <span class="badge product-card__badge product-card__badge--warning">Sắp hết hàng</span>
                                                </div>
                                            }
                                        </div>
                                        <div class="card-body product-card__body d-flex flex-column">
                                            <span class="product-card__category">@category.CategoryName</span>
                                            <h6 class="card-title product-card__title">@product.ProductName</h6>
                                            <p class="product-card__price">@product.Price.ToString("N0") <span class="product-card__currency">VNĐ</span></p>
                                            <div class="product-card__actions mt-auto">
                                                @if (user != null && user.UserType != "Customer")
                                                {
                                                    <a asp-controller="Home" asp-action="ProductDetails" asp-route-id="@product.ProductId" class="btn btn-outline-primary btn-sm w-100" onclick="event.stopPropagation();">Xem chi tiết</a>
                                                }
                                                else
                                                {
                                                    <div class="d-grid gap-2">
                                                        @if (product.Stock > 0)
                                                        {
                                                            <form asp-controller="Cart" asp-action="Add" method="post" class="d-inline" onclick="event.stopPropagation();">
                                                                <input type="hidden" name="productId" value="@product.ProductId" />
                                                                <input type="hidden" name="quantity" value="1" />
                                                                <button type="submit" class="btn btn-primary btn-sm w-100">Thêm vào giỏ</button>
                                                            </form>
                                                        }
                                                        else
                                                        {
                                                            <button class="btn btn-secondary btn-sm w-100" disabled>
                                                                <i class="fas fa-times me-1"></i>Hết hàng
                                                            </button>
                                                        }
                                                        <a asp-controller="Home" asp-action="ProductDetails" asp-route-id="@product.ProductId" class="btn btn-outline-primary btn-sm" onclick="event.stopPropagation();">Xem chi tiết</a>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        
                        @if (category.Products.Count() > 6)
                        {
                            <div class="text-center mt-3">
                                <a asp-controller="Home" asp-action="Shop" class="btn btn-outline-secondary btn-sm">
                                    Xem thêm @(category.Products.Count() - 6) sản phẩm khác
                                </a>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-light" role="alert">
                            <i class="fas fa-info-circle me-2"></i>
                            Chưa có sản phẩm nào trong danh mục này.
                        </div>
                    }
                </div>
            }
            
            <div class="text-center mt-4">
                <a asp-controller="Home" asp-action="Shop" class="btn btn-outline-primary btn-lg">
                    <i class="fas fa-store me-2"></i>Xem tất cả sản phẩm
                </a>
            </div>
        }
        else
        {
            <div class="alert alert-info" role="alert">
                <h4 class="alert-heading">Chưa có sản phẩm nào!</h4>
                <p>Hiện tại cửa hàng chưa có sản phẩm nào. Vui lòng quay lại sau.</p>
            </div>
        }
    </div>
</div>

<style>
    /* ===== Home - Luxury Cinematic Gallery ===== */

    /* ===== Cinematic Hero Carousel ===== */
    .cinematic-hero {
        position: relative;
        /* Full-bleed: tràn hết chiều ngang màn hình dù nằm trong .container */
        width: 100vw;
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
        min-height: 80vh;
        text-align: center;
        background-color: var(--lux-black, #000);
        margin-bottom: 5rem;
        overflow: hidden;
    }

    /* Lớp ảnh nền (carousel) chạy phía sau */
    .cinematic-hero__bg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 1;
    }

    .cinematic-hero__bg .carousel-inner,
    .cinematic-hero__bg .carousel-item {
        height: 100%;
    }

    /* Mỗi ảnh nền của 1 slide */
    .cinematic-hero__slide {
        width: 100%;
        height: 100%;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }

    /* Lớp phủ tối dần từ trên xuống để nổi bật chữ + form (trên mỗi slide) */
    .cinematic-hero__overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom, rgba(0,0,0,0.35) 0%, rgba(0,0,0,0.92) 100%);
        z-index: 2;
    }

    /* Lớp nội dung đứng im tuyệt đối ở giữa, KHÔNG trượt theo ảnh */
    .cinematic-hero__content {
        position: absolute;
        inset: 0;
        z-index: 10;
        padding: 2rem 1.5rem;
        /* Cho phép click xuyên qua vùng trống để bấm được indicators phía dưới */
        pointer-events: none;
    }

    .cinematic-hero__inner {
        width: 100%;
        max-width: 760px;
        margin: 0 auto;
        pointer-events: auto;
    }

    /* Indicators (dấu chấm điều hướng) - dạng gạch ngang mỏng, sang trọng */
    .cinematic-hero__indicators {
        z-index: 11;
        bottom: 1.5rem;
        margin-bottom: 0;
    }

    .cinematic-hero__indicators [data-bs-target] {
        width: 36px;
        height: 3px;
        border: none;
        border-radius: 0;
        background-color: rgba(255,255,255,0.45);
        opacity: 1;
        transition: background-color 0.3s ease;
    }

    .cinematic-hero__indicators .active {
        background-color: var(--lux-white, #fff);
    }

    .cinematic-hero__eyebrow {
        font-family: 'Montserrat', sans-serif;
        font-weight: 400;
        text-transform: uppercase;
        letter-spacing: 0.4em;
        font-size: 0.78rem;
        color: var(--lux-muted, #b3b3b3);
        margin-bottom: 1.25rem;
    }

    .cinematic-hero__title {
        font-family: 'Montserrat', sans-serif;
        font-weight: 300;
        text-transform: uppercase;
        letter-spacing: 0.16em;
        color: var(--lux-white, #fff);
        font-size: clamp(2rem, 5.5vw, 3.6rem);
        line-height: 1.2;
        margin-bottom: 1.25rem;
    }

    .cinematic-hero__title span {
        font-weight: 600;
        display: inline-block;
    }

    .cinematic-hero__subtitle {
        color: var(--lux-muted, #b3b3b3);
        font-weight: 300;
        letter-spacing: 0.04em;
        font-size: 1.05rem;
        margin-bottom: 2.5rem;
    }

    /* Search bar tối giản trong hero */
    .cinematic-hero__search {
        display: flex;
        align-items: stretch;
        justify-content: center;
        gap: 0;
        max-width: 560px;
        margin: 0 auto;
        border: 1px solid rgba(255,255,255,0.5);
        background: rgba(0,0,0,0.25);
        backdrop-filter: blur(4px);
    }

    .cinematic-hero__input {
        flex: 1 1 auto;
        background: transparent;
        border: none;
        outline: none;
        color: var(--lux-white, #fff);
        font-family: 'Inter', sans-serif;
        font-weight: 300;
        letter-spacing: 0.02em;
        padding: 0.95rem 1.25rem;
    }

    .cinematic-hero__input::placeholder { color: var(--lux-faint, #808080); }
    .cinematic-hero__input:focus { background: transparent; box-shadow: none; }

    /* Ghost Button */
    .cinematic-hero__btn {
        flex: 0 0 auto;
        background: transparent;
        border: none;
        border-left: 1px solid rgba(255,255,255,0.5);
        color: var(--lux-white, #fff);
        font-family: 'Montserrat', sans-serif;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-size: 0.82rem;
        padding: 0.95rem 1.75rem;
        cursor: pointer;
        transition: all 0.4s ease;
    }

    .cinematic-hero__btn:hover {
        background: var(--lux-white, #fff);
        color: #000;
    }

    .cinematic-hero__clear {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        border-left: 1px solid rgba(255,255,255,0.5);
        color: var(--lux-muted, #b3b3b3);
        padding: 0 1.1rem;
        transition: all 0.3s ease;
    }

    .cinematic-hero__clear:hover { color: var(--lux-white, #fff); }

    .cinematic-hero__welcome {
        margin-top: 2rem;
        color: var(--lux-muted, #b3b3b3);
        font-weight: 300;
        font-size: 0.95rem;
    }

    .cinematic-hero__welcome strong { color: var(--lux-white, #fff); font-weight: 500; }
    .cinematic-hero__welcome a { color: var(--lux-white, #fff); text-decoration: underline; }
    .cinematic-hero__welcome a:hover { color: var(--lux-muted, #b3b3b3); }

    /* Mũi tên cuộn xuống */
    .cinematic-hero__scroll {
        position: absolute;
        bottom: 3.25rem;
        left: 50%;
        transform: translateX(-50%);
        z-index: 11;
        color: rgba(255,255,255,0.65);
        font-size: 1.3rem;
        animation: heroBounce 2s ease-in-out infinite;
    }

    .cinematic-hero__scroll:hover { color: var(--lux-white, #fff); }

    @@keyframes heroBounce {
        0%, 100% { transform: translateX(-50%) translateY(0); }
        50% { transform: translateX(-50%) translateY(8px); }
    }

    /* ===== Featured Collections ===== */
    .featured-section { margin-bottom: 5rem; }

    .featured-section__head { margin-bottom: 3rem; }

    .featured-section__eyebrow {
        font-family: 'Montserrat', sans-serif;
        font-weight: 400;
        text-transform: uppercase;
        letter-spacing: 0.4em;
        font-size: 0.72rem;
        color: var(--lux-faint, #808080);
        margin-bottom: 0.75rem;
    }

    .featured-section__title {
        font-family: 'Montserrat', sans-serif;
        font-weight: 300;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        color: var(--lux-white, #fff) !important;
        font-size: clamp(1.6rem, 3.5vw, 2.4rem);
        margin-bottom: 1rem;
    }

    .lux-divider {
        display: inline-block;
        width: 60px;
        height: 1px;
        background: rgba(255,255,255,0.4);
    }

    /* Card dọc (portrait), tiêu đề đè lên đáy ảnh */
    .collection-card {
        position: relative;
        display: block;
        overflow: hidden;
        border-radius: 4px;
        background: var(--lux-surface, #111);
        aspect-ratio: 3 / 4;
        text-decoration: none;
    }

    .collection-card__img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.7s ease;
    }

    .collection-card:hover .collection-card__img { transform: scale(1.05); }

    .collection-card__overlay {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 1.75rem;
        background: linear-gradient(to bottom, rgba(0,0,0,0) 40%, rgba(0,0,0,0.85) 100%);
    }

    .collection-card__label {
        font-family: 'Montserrat', sans-serif;
        font-weight: 400;
        text-transform: uppercase;
        letter-spacing: 0.3em;
        font-size: 0.62rem;
        color: var(--lux-faint, #b3b3b3);
        margin-bottom: 0.4rem;
    }

    .collection-card__title {
        font-family: 'Montserrat', sans-serif;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-size: 1.25rem;
        color: var(--lux-white, #fff);
        margin: 0;
    }

    .collection-card__count {
        margin-top: 0.4rem;
        font-family: 'Inter', sans-serif;
        font-weight: 300;
        font-size: 0.82rem;
        color: var(--lux-muted, #b3b3b3);
    }

    @@media (max-width: 767.98px) {
        .cinematic-hero { background-attachment: scroll; min-height: 80vh; }
        .collection-card { aspect-ratio: 4 / 5; }
    }

    /* Tiêu đề section */
    .container h2,
    .container h3.text-primary {
        color: var(--lux-white, #fff) !important;
    }

    /* ===== Product Card — khung rõ ràng, dễ phân biệt từng sản phẩm ===== */
    .product-grid {
        margin-bottom: 0.5rem;
    }

    .product-card {
        background: var(--lux-surface, #111) !important;
        border: 1px solid rgba(255, 255, 255, 0.12) !important;
        border-radius: 0 !important;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.35) !important;
        color: var(--lux-white, #fff) !important;
        overflow: hidden;
        transition: border-color 0.35s ease, transform 0.35s ease, box-shadow 0.35s ease;
    }

    .product-card:hover {
        border-color: rgba(255, 255, 255, 0.32) !important;
        transform: translateY(-4px);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5) !important;
    }

    /* Vùng ảnh — tách biệt với phần chữ bằng đường kẻ mờ */
    .product-card__image-wrap {
        overflow: hidden;
        background: #0a0a0a;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .product-card__img {
        width: 100%;
        height: 220px;
        object-fit: cover;
        border-radius: 0 !important;
        transition: transform 0.55s ease;
    }

    .product-card__img--placeholder {
        height: 220px;
        background: #0a0a0a !important;
        color: var(--lux-muted, #b3b3b3) !important;
    }

    .product-card:hover .product-card__img {
        transform: scale(1.04);
    }

    /* Phần thông tin — căn trái, có padding đồng nhất */
    .product-card__body {
        padding: 1rem 1.1rem 1.15rem !important;
        text-align: left;
    }

    .product-card__category {
        display: inline-block;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.65rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.14em;
