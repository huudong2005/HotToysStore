@model ToyStore.Domain.Entities.Product
@{
    ViewData["Title"] = "Chi tiết sản phẩm";
    var user = ViewBag.User as ToyStore.Models.UserSession;
}

<link rel="stylesheet" href="~/css/product-details.css?v=1" />

<div class="container mt-4 pb-5">
    <div class="row">
        <!-- Hình ảnh sản phẩm -->
        <div class="col-md-6">
            <div class="product-image-container">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" class="img-fluid rounded product-image" alt="@Model.ProductName" style="max-height: 500px; width: 100%; object-fit: cover;">
                }
                else
                {
                    <div class="bg-dark d-flex align-items-center justify-content-center rounded product-image-placeholder">
                        <i class="fas fa-image fa-5x text-muted"></i>
                    </div>
                }
            </div>
        </div>

        <!-- Thông tin sản phẩm -->
        <div class="col-md-6">
            <div class="product-info">
                <h1 class="product-title mb-3">@Model.ProductName</h1>

                <div class="product-meta mb-3">
                    <span class="badge badge-category">@Model.Category.CategoryName</span>
                    @if (Model.Status == true && Model.Stock > 0)
                    {
                        <span class="badge badge-in-stock ms-2">Còn hàng</span>
                    }
                    else if (Model.Status == true && Model.Stock == 0)
                    {
                        <span class="badge badge-out-stock ms-2">Hết hàng</span>
                    }
                    else
                    {
                        <span class="badge badge-unavailable ms-2">Không bán</span>
                    }
                </div>

                <div class="product-price mb-4">
                    <h2 class="price-text fw-bold">@Model.Price.ToString("N0") VNĐ</h2>
                </div>

                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="product-description mb-4">
                        <h5 class="desc-title">Mô tả sản phẩm</h5>
                        <p class="desc-text">@Model.Description</p>
                    </div>
                }

                <div class="product-stock mb-4">
                    @if (Model.Status == true && Model.Stock > 0)
                    {
                        <h6 class="stock-title">Số lượng tồn kho: <span class="stock-available">@Model.Stock sản phẩm</span></h6>
                    }
                    else if (Model.Status == true && Model.Stock == 0)
                    {
                        <h6 class="stock-title">Số lượng tồn kho: <span class="stock-out">Hết hàng</span></h6>
                    }
                    else
                    {
                        <h6 class="stock-title">Số lượng tồn kho: <span class="stock-unavailable">Không bán</span></h6>
                    }
                </div>

                <!-- Các nút hành động -->
                <div class="product-actions">
                    @if (user != null && user.UserType != "Customer")
                    {
                        <div class="alert alert-info-custom" role="alert">
                            <i class="fas fa-info-circle me-2"></i>
                            Bạn đang đăng nhập với tư cách <strong>@user.UserType</strong>.
                            <a asp-controller="Auth" asp-action="Logout" class="alert-link">Đăng xuất</a> để mua hàng với tài khoản khách.
                        </div>
                    }
                    else if (Model.Status == true && Model.Stock > 0)
                    {
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <form asp-controller="Cart" asp-action="Add" method="post">
                                    <input type="hidden" name="productId" value="@Model.ProductId" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="btn btn-cart btn-lg w-100">
                                        <i class="fas fa-shopping-cart me-2"></i>Thêm vào giỏ
                                    </button>
                                </form>
                            </div>
                            <div class="col-md-6">
                                <form asp-controller="Order" asp-action="BuyNow" method="post">
                                    <input type="hidden" name="productId" value="@Model.ProductId" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="btn btn-buy-now btn-lg w-100">
                                        <i class="fas fa-bolt me-2"></i>Mua ngay
                                    </button>
                                </form>
                            </div>
                        </div>
                        @if (user == null)
                        {
                            <p class="text-muted small mb-0">
                                <i class="fas fa-user-clock me-1"></i>
                                Mua không cần đăng ký — nhập thông tin giao hàng khi thanh toán.
                                Đã có tài khoản? <a asp-controller="Auth" asp-action="Login">Đăng nhập</a>
                            </p>
                        }
                    }
                    else if (Model.Status == true && Model.Stock == 0)
                    {
                        <div class="alert alert-out-stock" role="alert">
                            <i class="fas fa-times-circle me-2"></i>
                            <strong>Sản phẩm đã hết hàng!</strong> Vui lòng chọn sản phẩm khác hoặc quay lại sau.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-unavailable" role="alert">
                            <i class="fas fa-ban me-2"></i>
                            <strong>Sản phẩm không được bán!</strong> Sản phẩm này hiện không có sẵn.
                        </div>
                    }
                </div>

                <!-- Thông tin bổ sung -->
                <div class="product-additional-info mt-4">
                    <div class="row">
                        <div class="col-6">
                            <div class="info-item">
                                <i class="fas fa-truck icon-info"></i>
                                <small class="info-text">Giao hàng miễn phí</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="info-item">
                                <i class="fas fa-shield-alt icon-info"></i>
                                <small class="info-text">Bảo hành chính hãng</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="info-item">
                                <i class="fas fa-undo icon-info"></i>
                                <small class="info-text">Đổi trả trong 7 ngày</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="info-item">
                                <i class="fas fa-headset icon-info"></i>
                                <small class="info-text">Hỗ trợ 24/7</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Nút quay lại -->
    <div class="row mt-5 pt-4 border-top border-neon">
        <div class="col-12">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-back">
                <i class="fas fa-arrow-left me-2"></i>Quay lại trang chủ
            </a>
            <a asp-controller="Home" asp-action="Shop" class="btn btn-outline-shop ms-2">
                <i class="fas fa-store me-2"></i>Xem tất cả sản phẩm
            </a>
        </div>
    </div>
</div>
