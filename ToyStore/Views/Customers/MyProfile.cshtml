@model ToyStore.Models.EditCustomerViewModel

@{
    ViewData["Title"] = "Thông tin cá nhân";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .profile-card {
        box-shadow: none;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 0;
        background: #111111;
    }

        .profile-card .card-header {
            background: transparent;
            color: #ffffff;
            border-radius: 0 !important;
            border-bottom: 1px solid rgba(255, 255, 255, 0.12);
            padding: 1.5rem;
        }

            .profile-card .card-header h4 {
                color: #ffffff !important;
                margin: 0;
                font-weight: 600;
                font-family: 'Montserrat', sans-serif;
                text-transform: uppercase;
                letter-spacing: 0.1em;
            }

    .section-divider {
        border-top: 1px solid rgba(255, 255, 255, 0.12);
        margin: 2rem 0 1.5rem 0;
        position: relative;
    }

    .section-title {
        background: #111111;
        padding: 0 15px;
        position: relative;
        top: -14px;
        display: inline-block;
        color: #ffffff;
        font-weight: 600;
        font-size: 1.1rem;
        font-family: 'Montserrat', sans-serif;
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

        .section-title i {
            color: #b3b3b3;
            margin-right: 8px;
        }

    .form-label {
        font-weight: 600;
        color: #b3b3b3;
        margin-bottom: 0.5rem;
        font-family: 'Montserrat', sans-serif;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-size: 0.78rem;
    }

        .form-label i {
            color: #b3b3b3;
            margin-right: 6px;
            width: 16px;
            text-align: center;
        }

    .form-control {
        border-radius: 0;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: transparent;
        color: #ffffff;
        padding: 0.75rem;
        transition: all 0.3s ease;
    }

        .form-control::placeholder {
            color: #808080;
        }

        .form-control:focus {
            border-color: #ffffff;
            background: transparent;
            color: #ffffff;
            box-shadow: none;
        }

    .password-section {
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.12);
        padding: 1.5rem;
        border-radius: 0;
        margin-top: 1rem;
    }

    .password-hint {
        background: #111111;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-left: 2px solid #ffffff;
        padding: 12px 16px;
        border-radius: 0;
        margin-bottom: 1rem;
        color: #ffffff;
    }

        .password-hint i {
            color: #ffffff;
            margin-right: 8px;
        }

    .btn-primary {
        background: transparent;
        border: 1px solid #ffffff;
        color: #ffffff;
        border-radius: 0;
        padding: 12px 30px;
        font-weight: 600;
        font-family: 'Montserrat', sans-serif;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        box-shadow: none;
        transition: all 0.4s ease;
    }

        .btn-primary:hover {
            background: #ffffff;
            color: #000;
            border-color: #ffffff;
            box-shadow: none;
        }

    .btn-secondary {
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: #b3b3b3;
        border-radius: 0;
        padding: 12px 30px;
        font-weight: 600;
        font-family: 'Montserrat', sans-serif;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        box-shadow: none;
        transition: all 0.4s ease;
    }

        .btn-secondary:hover {
            background: #ffffff;
            color: #000;
            border-color: #ffffff;
        }

    .input-group .password-toggle-btn {
        border-radius: 0;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-left: none;
        background: transparent;
        color: #b3b3b3;
        transition: all 0.3s ease;
    }

        .input-group .password-toggle-btn:hover {
            background: #ffffff;
            color: #000;
        }

    .input-group .form-control {
        border-radius: 0;
    }

    .input-group:focus-within .password-toggle-btn {
        border-color: #ffffff;
    }
</style>

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-9">
            <div class="card profile-card">
                <div class="card-header">
                    <h4>
                        <i class="fas fa-user-edit"></i> Chỉnh sửa thông tin cá nhân
                    </h4>
                </div>
                <div class="card-body p-4">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="MyProfile" method="post" autocomplete="off">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input asp-for="CustomerId" type="hidden" />

                        <!-- Thông tin cơ bản -->
                        <div class="section-title">
                            <i class="fas fa-user-circle"></i> Thông tin cơ bản
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FullName" class="form-label">
                                    <i class="fas fa-user"></i> Họ và tên
                                </label>
                                <input asp-for="FullName" class="form-control" placeholder="Nhập họ và tên đầy đủ" />
                                <span asp-validation-for="FullName" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label">
                                    <i class="fas fa-envelope"></i> Email
                                </label>
                                <input asp-for="Email" class="form-control" placeholder="example@email.com" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Phone" class="form-label">
                                    <i class="fas fa-phone"></i> Số điện thoại
                                </label>
                                <input asp-for="Phone" class="form-control" placeholder="0123456789" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Address" class="form-label">
                                    <i class="fas fa-map-marker-alt"></i> Địa chỉ
                                </label>
                                <input asp-for="Address" class="form-control" placeholder="Nhập địa chỉ của bạn" />
                                <span asp-validation-for="Address" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Phần đổi mật khẩu -->
                        <div class="section-divider"></div>

                        <div class="password-section">
                            <div class="section-title mb-3">
                                <i class="fas fa-key"></i> Đổi mật khẩu (tùy chọn)
                            </div>

                            <div class="password-hint">
                                <i class="fas fa-info-circle"></i>
                                <small style="color: #ffffff;">
                                    <strong>Lưu ý:</strong> Để đổi mật khẩu, vui lòng điền đầy đủ cả 3 trường bên dưới.
                                    Nếu không muốn đổi mật khẩu, hãy để trống tất cả các trường này.
                                </small>
                            </div>

                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label asp-for="CurrentPassword" class="form-label">
                                        <i class="fas fa-lock"></i> Mật khẩu hiện tại
                                    </label>
                                    <div class="input-group">
                                        <input asp-for="CurrentPassword"
                                               class="form-control"
                                               id="CurrentPassword"
                                               type="password"
                                               autocomplete="off"
                                               placeholder="Nhập mật khẩu hiện tại" />
                                        <button type="button"
                                                class="btn btn-outline-secondary password-toggle-btn"
                                                data-target="CurrentPassword"
                                                title="Hiện/Ẩn mật khẩu">
                                            <i class="bi bi-eye password-toggle-icon"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                                </div>

                                <div class="col-md-4 mb-3">
                                    <label asp-for="NewPassword" class="form-label">
                                        <i class="fas fa-key"></i> Mật khẩu mới
                                    </label>
                                    <div class="input-group">
                                        <input asp-for="NewPassword"
                                               class="form-control"
                                               id="NewPassword"
                                               type="password"
                                               autocomplete="new-password"
                                               placeholder="Ít nhất 6 ký tự" />
                                        <button type="button"
                                                class="btn btn-outline-secondary password-toggle-btn"
                                                data-target="NewPassword"
                                                title="Hiện/Ẩn mật khẩu">
                                            <i class="bi bi-eye password-toggle-icon"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                                </div>

                                <div class="col-md-4 mb-3">
                                    <label asp-for="NewPasswordConfirm" class="form-label">
                                        <i class="fas fa-check-circle"></i> Xác nhận mật khẩu mới
                                    </label>
                                    <div class="input-group">
                                        <input asp-for="NewPasswordConfirm"
                                               class="form-control"
                                               id="NewPasswordConfirm"
                                               type="password"
                                               autocomplete="new-password"
                                               placeholder="Nhập lại mật khẩu mới" />
                                        <button type="button"
                                                class="btn btn-outline-secondary password-toggle-btn"
                                                data-target="NewPasswordConfirm"
                                                title="Hiện/Ẩn mật khẩu">
                                            <i class="bi bi-eye password-toggle-icon"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="NewPasswordConfirm" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Nút hành động -->
                        <div class="d-flex justify-content-between mt-4 pt-3">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Cập nhật thông tin
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Password toggle functionality đã có trong site.js
        // Chỉ cần đảm bảo Bootstrap Icons đã được load
        document.addEventListener("DOMContentLoaded", function () {
            const passwordFieldIds = ["CurrentPassword", "NewPassword", "NewPasswordConfirm"];
            passwordFieldIds.forEach(function (fieldId) {
                const input = document.getElementById(fieldId);
                if (input) {
                    // Tránh trình duyệt giữ lại giá trị cũ khi quay lại trang profile
                    input.value = "";
                }
            });
        });
    </script>
}
