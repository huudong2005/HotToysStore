@model IEnumerable<ToyStore.Domain.Entities.Customer>

@{
    ViewData["Title"] = "Quản lý khách hàng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-users"></i> Quản lý khách hàng</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Thêm khách hàng mới
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th><i class="fas fa-id-card me-2"></i>ID</th>
                            <th><i class="fas fa-user me-2"></i>Họ tên</th>
                            <th><i class="fas fa-envelope me-2"></i>Email</th>
                            <th><i class="fas fa-phone me-2"></i>Số điện thoại</th>
                            <th><i class="fas fa-map-marker-alt me-2"></i>Địa chỉ</th>
                            <th><i class="fas fa-calendar me-2"></i>Ngày tạo</th>
                            <th><i class="fas fa-shield-alt me-2"></i>Trạng thái</th>
                            <th><i class="fas fa-cogs me-2"></i>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-primary">#@item.CustomerId</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle me-2">
                                            <i class="fas fa-user"></i>
                                        </div>
                                        <div>
                                            <strong>@item.FullName</strong>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <a href="mailto:@item.Email" class="text-decoration-none">
                                        <i class="fas fa-envelope me-1"></i>@item.Email
                                    </a>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Phone))
                                    {
                                        <a href="tel:@item.Phone" class="text-decoration-none">
                                            <i class="fas fa-phone me-1"></i>@item.Phone
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Chưa cập nhật</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Address))
                                    {
                                        <span title="@item.Address">
                                            @(item.Address.Length > 30 ? item.Address.Substring(0, 30) + "..." : item.Address)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Chưa cập nhật</span>
                                    }
                                </td>
                                <td>
                                    <span class="text-muted">@item.CreatedAt?.ToString("dd/MM/yyyy")</span>
                                </td>
                                <td>
                                    @if (item.IsLocked)
                                    {
                                        <span class="badge status-badge status-badge--locked" id="status-badge-@item.CustomerId">
                                            <i class="fas fa-lock me-1"></i>Bị khóa
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge status-badge status-badge--active" id="status-badge-@item.CustomerId">
                                            <i class="fas fa-check-circle me-1"></i>Hoạt động
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group customer-actions" role="group">
                                        <a asp-action="Details" asp-route-id="@item.CustomerId" class="btn btn-sm btn-info" title="Xem chi tiết">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.CustomerId" class="btn btn-sm btn-warning" title="Sửa">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-light btn-toggle-lock"
                                                data-id="@item.CustomerId"
                                                data-locked="@(item.IsLocked ? "true" : "false")"
                                                title="@(item.IsLocked ? "Mở khóa tài khoản" : "Khóa tài khoản")"
                                                id="toggle-lock-@item.CustomerId">
                                            <i class="fas @(item.IsLocked ? "fa-lock-open" : "fa-lock")"></i>
                                        </button>
                                        <a asp-action="Delete" asp-route-id="@item.CustomerId" class="btn btn-sm btn-danger" title="Xóa">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-4">
                <i class="fas fa-users fa-3x text-muted mb-3"></i>
                <h5 class="text-muted">Chưa có khách hàng nào</h5>
                <p class="text-muted">Hãy thêm khách hàng đầu tiên</p>
                <a asp-action="Create" class="btn btn-primary">Thêm khách hàng</a>
            </div>
        }
    </div>
</div>

@* Token chống giả mạo cho AJAX khóa/mở khóa *@
<form id="antiForgeryForm" class="d-none">
    @Html.AntiForgeryToken()
</form>

<style>
    /* ===== Quản lý khách hàng - Luxury Cinematic Gallery ===== */
    .avatar-circle {
        width: 35px;
        height: 35px;
        background: transparent;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.25));
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--lux-white, #fff);
        font-size: 0.9rem;
    }

    .table th {
        border-top: none;
        font-family: 'Montserrat', sans-serif;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        background: transparent !important;
        color: var(--lux-white, #fff) !important;
        border-bottom: 1px solid var(--lux-line, rgba(255,255,255,0.12)) !important;
    }

    .table td {
        vertical-align: middle;
        color: var(--lux-white, #fff) !important;
        border-color: var(--lux-line-soft, rgba(255,255,255,0.06)) !important;
    }

    .table-striped > tbody > tr:nth-of-type(odd) > td {
        background-color: rgba(255, 255, 255, 0.02) !important;
    }

    .table-hover > tbody > tr:hover > td {
        background-color: rgba(255, 255, 255, 0.05) !important;
    }

    .btn-group .btn { margin-right: 4px; }
    .btn-group .btn:last-child { margin-right: 0; }

    .card {
        background: var(--lux-surface, #111) !important;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.12)) !important;
        border-radius: 0 !important;
        box-shadow: none !important;
    }

    .card-body { color: var(--lux-white, #fff) !important; }

    .alert-success,
    .alert-danger {
        background: var(--lux-surface, #111) !important;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.12)) !important;
        color: var(--lux-white, #fff) !important;
        border-radius: 0 !important;
    }
    .alert-success { border-left: 2px solid var(--lux-white, #fff) !important; }
    .alert-danger { border-left: 2px solid var(--lux-muted, #b3b3b3) !important; }

    /* Mọi nút -> Ghost trắng */
    .btn-primary,
    .btn-info,
    .btn-warning,
    .btn-danger {
        background: transparent !important;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.25)) !important;
        color: var(--lux-white, #fff) !important;
        border-radius: 0 !important;
        font-family: 'Montserrat', sans-serif;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        box-shadow: none !important;
        transition: all 0.4s ease;
    }

    .btn-primary:hover,
    .btn-info:hover,
    .btn-warning:hover,
    .btn-danger:hover {
        background: var(--lux-white, #fff) !important;
        color: #000 !important;
        border-color: var(--lux-white, #fff) !important;
        transform: none;
        box-shadow: none !important;
    }

    .text-muted { color: var(--lux-muted, #b3b3b3) !important; }

    /* Liên kết email/phone */
    .text-decoration-none { color: var(--lux-white, #fff) !important; }
    .text-decoration-none:hover { color: var(--lux-muted, #b3b3b3) !important; }

    /* Badge ghost */
    .badge,
    .badge.bg-primary {
        background: transparent !important;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.3)) !important;
        color: var(--lux-muted, #b3b3b3) !important;
        border-radius: 0 !important;
        font-family: 'Montserrat', sans-serif;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    /* Badge trạng thái tài khoản */
    .status-badge {
        background: transparent !important;
        border-radius: 0 !important;
        font-family: 'Montserrat', sans-serif;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        font-size: 0.72rem;
        padding: 0.35rem 0.6rem;
    }

    .status-badge--active {
        border: 1px solid rgba(74, 222, 128, 0.5) !important;
        color: #4ade80 !important;
    }

    .status-badge--locked {
        border: 1px solid rgba(248, 113, 113, 0.5) !important;
        color: #f87171 !important;
    }

    /* Nút khóa/mở khóa */
    .btn-outline-light {
        background: transparent !important;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.25)) !important;
        color: var(--lux-white, #fff) !important;
        border-radius: 0 !important;
    }

    .btn-outline-light:hover {
        background: var(--lux-white, #fff) !important;
        color: #000 !important;
        border-color: var(--lux-white, #fff) !important;
    }

    .customer-actions .btn { margin-right: 4px; }
    .customer-actions .btn:last-child { margin-right: 0; }
</style>

@section Scripts {
    <script>
        (function () {
            const tokenInput = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]');
            if (!tokenInput) return;

            function updateStatusBadge(customerId, isLocked) {
                const badge = document.getElementById('status-badge-' + customerId);
                if (!badge) return;

                badge.classList.remove('status-badge--active', 'status-badge--locked');
                if (isLocked) {
                    badge.classList.add('status-badge--locked');
                    badge.innerHTML = '<i class="fas fa-lock me-1"></i>Bị khóa';
                } else {
                    badge.classList.add('status-badge--active');
                    badge.innerHTML = '<i class="fas fa-check-circle me-1"></i>Hoạt động';
                }
            }

            function updateToggleButton(btn, isLocked) {
                btn.dataset.locked = isLocked ? 'true' : 'false';
                btn.title = isLocked ? 'Mở khóa tài khoản' : 'Khóa tài khoản';
                const icon = btn.querySelector('i');
                if (icon) {
                    icon.className = isLocked ? 'fas fa-lock-open' : 'fas fa-lock';
                }
            }

            document.querySelectorAll('.btn-toggle-lock').forEach(function (btn) {
                btn.addEventListener('click', async function () {
                    const customerId = this.dataset.id;
                    const isCurrentlyLocked = this.dataset.locked === 'true';
                    const action = isCurrentlyLocked ? 'mở khóa' : 'khóa';

                    if (!confirm('Bạn có chắc muốn ' + action + ' tài khoản khách hàng #' + customerId + '?')) {
                        return;
                    }

                    const originalHtml = this.innerHTML;
                    this.disabled = true;
                    this.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

                    try {
                        const response = await fetch('/Customers/ToggleLock?id=' + customerId, {
                            method: 'POST',
                            headers: {
                                'Accept': 'application/json',
                                'RequestVerificationToken': tokenInput.value
                            }
                        });

                        const data = await response.json();

                        if (data.success) {
                            updateStatusBadge(customerId, data.isLocked);
                            updateToggleButton(this, data.isLocked);
                        } else {
                            alert(data.message || 'Không thể thay đổi trạng thái tài khoản.');
                        }
                    } catch (err) {
                        alert('Có lỗi xảy ra, vui lòng thử lại.');
                    } finally {
                        this.disabled = false;
                        updateToggleButton(this, this.dataset.locked === 'true');
                    }
                });
            });
        })();
    </script>
}
