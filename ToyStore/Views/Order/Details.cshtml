@model ToyStore.Domain.Entities.Order

@{
    ViewData["Title"] = "Chi tiết đơn hàng";

    (string label, string css) StatusBadge(string? status) => status switch
    {
        "Pending" => ("Chờ xác nhận", "cod-badge--pending"),
        "Confirmed" => ("Đã xác nhận", "cod-badge--success"),
        "Processing" => ("Đang xử lý", "cod-badge--info"),
        "Shipped" => ("Đang giao", "cod-badge--primary"),
        "Delivered" => ("Đã giao", "cod-badge--success"),
        "Cancelled" => ("Đã hủy", "cod-badge--danger"),
        _ => (string.IsNullOrEmpty(status) ? "Không rõ" : status, "cod-badge--secondary")
    };

    string PaymentLabel(string? method) => method switch
    {
        "COD" => "Thanh toán khi nhận hàng",
        "BankTransfer" => "Chuyển khoản ngân hàng",
        _ => string.IsNullOrWhiteSpace(method) ? "—" : method
    };

    var badge = StatusBadge(Model.Status);
    var itemCount = Model.OrderDetails?.Sum(d => d.Quantity) ?? 0;
}

<div class="container cod">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h2 class="mb-1"><i class="fas fa-receipt me-2"></i>Chi tiết đơn hàng #@Model.OrderId</h2>
            <p class="text-muted mb-0"><i class="far fa-clock me-1"></i>@(Model.OrderDate?.ToString("dd/MM/yyyy HH:mm") ?? "—")</p>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="cod-badge @badge.css">@badge.label</span>
            <a href="/Order/MyOrders" class="btn btn-outline-light"><i class="fas fa-arrow-left me-1"></i>Quay lại</a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Cột chính: đơn hàng + sản phẩm -->
        <div class="col-lg-8">
            <div class="cod-card mb-4">
                <div class="cod-card__head"><i class="fas fa-circle-info me-2"></i>Thông tin đơn hàng</div>
                <div class="cod-card__body">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <span class="cod-field__label">Mã đơn hàng</span>
                            <span class="cod-field__value">#@Model.OrderId</span>
                        </div>
                        <div class="col-sm-6">
                            <span class="cod-field__label">Ngày đặt</span>
                            <span class="cod-field__value">@(Model.OrderDate?.ToString("dd/MM/yyyy HH:mm") ?? "—")</span>
                        </div>
                        <div class="col-sm-6">
                            <span class="cod-field__label">Phương thức thanh toán</span>
                            <span class="cod-field__value">@PaymentLabel(Model.PaymentMethod)</span>
                        </div>
                        <div class="col-sm-6">
                            <span class="cod-field__label">Phương thức giao</span>
                            <span class="cod-field__value">@(string.IsNullOrWhiteSpace(Model.DeliveryMethod) ? "—" : Model.DeliveryMethod)</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="cod-card">
                <div class="cod-card__head d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-box-open me-2"></i>Danh sách sản phẩm</span>
                    <span class="text-muted small">@itemCount sản phẩm</span>
                </div>
                <div class="cod-card__body p-0">
                    <div class="table-responsive">
                        <table class="table cod-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th class="text-end">Giá</th>
                                    <th class="text-center">SL</th>
                                    <th class="text-end">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var detail in Model.OrderDetails)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                @if (detail.Product != null && !string.IsNullOrEmpty(detail.Product.ImageUrl))
                                                {
                                                    <img src="@detail.Product.ImageUrl" alt="@detail.Product.ProductName" class="cod-thumb" />
                                                }
                                                else
                                                {
                                                    <div class="cod-thumb cod-thumb--empty"><i class="fas fa-image"></i></div>
                                                }
                                                <div>
                                                    <div class="cod-product-name">@(detail.Product?.ProductName ?? "Sản phẩm không tồn tại")</div>
                                                    <div class="text-muted small">@(detail.Product?.Category?.CategoryName ?? "—")</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-end">@detail.UnitPrice.ToString("#,##0") ₫</td>
                                        <td class="text-center">@detail.Quantity</td>
                                        <td class="text-end fw-semibold">@((detail.UnitPrice * detail.Quantity).ToString("#,##0")) ₫</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="cod-summary-wrap">
                        <div class="cod-summary">
                            <span>Tạm tính</span>
                            <span>@Model.Subtotal.ToString("#,##0") ₫</span>
                        </div>
                        @if (Model.DiscountValue > 0)
                        {
                            <div class="cod-summary cod-summary--discount">
                                <span>Giảm giá</span>
                                <span>- @Model.DiscountValue.ToString("#,##0") ₫</span>
                            </div>
                        }
                        <hr class="cod-divider" />
                        <div class="cod-summary cod-summary--total">
                            <span>Tổng cộng</span>
                            <span>@Model.TotalAmount.ToString("#,##0") ₫</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột phụ: khách hàng + trạng thái -->
        <div class="col-lg-4">
            <div class="cod-card mb-4">
                <div class="cod-card__head"><i class="fas fa-user me-2"></i>Thông tin khách hàng</div>
                <div class="cod-card__body">
                    <div class="cod-info">
                        <span class="cod-field__label">Tên</span>
                        <span class="cod-field__value">@(Model.Customer?.FullName ?? "—")</span>
                    </div>
                    <div class="cod-info">
                        <span class="cod-field__label">Email</span>
                        <span class="cod-field__value">@(Model.Customer?.Email ?? "—")</span>
                    </div>
                    <div class="cod-info">
                        <span class="cod-field__label">Số điện thoại</span>
                        <span class="cod-field__value">@(string.IsNullOrWhiteSpace(Model.Customer?.Phone) ? "—" : Model.Customer!.Phone)</span>
                    </div>
                    <div class="cod-info">
                        <span class="cod-field__label">Địa chỉ</span>
                        <span class="cod-field__value">@(string.IsNullOrWhiteSpace(Model.Customer?.Address) ? "—" : Model.Customer!.Address)</span>
                    </div>
                </div>
            </div>

            @if (Model.Status == "Pending")
            {
                <div class="cod-card cod-status cod-status--pending">
                    <div class="cod-card__body text-center">
                        <i class="fas fa-hourglass-half cod-status__icon"></i>
                        <h6 class="cod-status__title">Đơn hàng đang chờ xác nhận</h6>
                        <p class="cod-status__text">Bạn có thể hủy đơn hàng này khi chưa được xác nhận.</p>
                        <form action="/Order/Cancel/@Model.OrderId" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-danger"
                                    onclick="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này?')">
                                <i class="fas fa-times me-1"></i>Hủy đơn hàng
                            </button>
                        </form>
                    </div>
                </div>
            }
            else if (Model.Status == "Confirmed")
            {
                <div class="cod-card cod-status cod-status--success">
                    <div class="cod-card__body text-center">
                        <i class="fas fa-check-circle cod-status__icon"></i>
                        <h6 class="cod-status__title">Đơn hàng đã được xác nhận</h6>
                        <p class="cod-status__text">Đơn hàng sẽ được xử lý và giao trong thời gian sớm nhất. Đơn đã xác nhận không thể hủy.</p>
                    </div>
                </div>
            }
            else if (Model.Status == "Delivered")
            {
                <div class="cod-card cod-status cod-status--success">
                    <div class="cod-card__body text-center">
                        <i class="fas fa-box-open cod-status__icon"></i>
                        <h6 class="cod-status__title">Đơn hàng đã được giao</h6>
                        <p class="cod-status__text">Cảm ơn bạn đã mua sắm tại ToyStore!</p>
                        <a href="/" class="btn btn-outline-light"><i class="fas fa-shopping-bag me-1"></i>Mua sắm tiếp</a>
                    </div>
                </div>
            }
            else if (Model.Status == "Cancelled")
            {
                <div class="cod-card cod-status cod-status--danger">
                    <div class="cod-card__body text-center">
                        <i class="fas fa-ban cod-status__icon"></i>
                        <h6 class="cod-status__title">Đơn hàng đã bị hủy</h6>
                        <p class="cod-status__text">Đơn hàng này đã được hủy.</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .cod { color: var(--lux-white, #fff); }

    .cod h2 { font-family: 'Montserrat', sans-serif; font-weight: 300; letter-spacing: 0.06em; }

    .cod-badge {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding: 0.45rem 0.9rem;
        border-radius: 999px;
        white-space: nowrap;
    }

    .cod-badge--pending { background: rgba(255,193,7,0.15); color: #ffc94d; border: 1px solid rgba(255,193,7,0.5); }
    .cod-badge--success { background: rgba(40,167,69,0.15); color: #5cd47a; border: 1px solid rgba(40,167,69,0.5); }
    .cod-badge--info { background: rgba(23,162,184,0.15); color: #4fd0e3; border: 1px solid rgba(23,162,184,0.5); }
    .cod-badge--primary { background: rgba(74,144,255,0.15); color: #7eacff; border: 1px solid rgba(74,144,255,0.5); }
    .cod-badge--danger { background: rgba(220,53,69,0.15); color: #ff7b87; border: 1px solid rgba(220,53,69,0.5); }
    .cod-badge--secondary { background: rgba(255,255,255,0.08); color: #b3b3b3; border: 1px solid rgba(255,255,255,0.25); }

    /* Card */
    .cod-card {
        background: var(--lux-surface, #111);
        border: 1px solid var(--lux-line, rgba(255,255,255,0.12));
        border-radius: 6px;
        overflow: hidden;
    }

    .cod-card__head {
        padding: 0.9rem 1.25rem;
        border-bottom: 1px solid var(--lux-line, rgba(255,255,255,0.12));
        font-family: 'Montserrat', sans-serif;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.85rem;
        color: var(--lux-white, #fff);
    }

    .cod-card__body { padding: 1.25rem; }

    /* Field dạng nhãn trên + giá trị dưới */
    .cod-field__label {
        display: block;
        color: var(--lux-faint, #808080);
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.2rem;
    }

    .cod-field__value { display: block; color: var(--lux-white, #fff); word-break: break-word; }

    /* Info dạng hàng (cột khách hàng) */
    .cod-info { padding: 0.55rem 0; border-bottom: 1px solid rgba(255,255,255,0.06); }
    .cod-info:last-child { border-bottom: none; }

    /* Bảng sản phẩm */
    .cod-table { color: var(--lux-white, #fff); }

    .cod-table thead th {
        background: transparent !important;
        color: var(--lux-muted, #b3b3b3) !important;
        border-bottom: 1px solid var(--lux-line, rgba(255,255,255,0.12)) !important;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-size: 0.72rem;
        font-weight: 500;
    }

    .cod-table tbody td {
        background: transparent !important;
        color: var(--lux-white, #fff) !important;
        border-bottom: 1px solid rgba(255,255,255,0.06) !important;
        vertical-align: middle;
        padding: 0.85rem 0.75rem;
    }

    .cod-table tbody tr:last-child td { border-bottom: none !important; }

    .cod-thumb { width: 52px; height: 52px; object-fit: cover; border-radius: 4px; background: #000; }
    .cod-thumb--empty {
        display: flex; align-items: center; justify-content: center;
        color: var(--lux-faint, #808080);
        border: 1px solid var(--lux-line, rgba(255,255,255,0.12));
    }

    .cod-product-name { font-weight: 500; color: var(--lux-white, #fff); }

    /* Tổng tiền */
    .cod-summary-wrap {
        padding: 1rem 1.25rem 1.25rem;
        border-top: 1px solid var(--lux-line, rgba(255,255,255,0.12));
    }

    .cod-summary {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.3rem 0;
        color: var(--lux-muted, #b3b3b3);
    }

    .cod-summary--discount span:last-child { color: #ff7b87; }
    .cod-divider { border-color: var(--lux-line, rgba(255,255,255,0.12)); opacity: 1; }

    .cod-summary--total {
        color: var(--lux-white, #fff);
        font-family: 'Montserrat', sans-serif;
        font-weight: 600;
        font-size: 1.25rem;
        letter-spacing: 0.03em;
    }

    /* Khối trạng thái */
    .cod-status__icon { font-size: 1.8rem; margin-bottom: 0.6rem; }
    .cod-status__title { font-weight: 500; letter-spacing: 0.03em; }
    .cod-status__text { color: var(--lux-muted, #b3b3b3); font-size: 0.88rem; }

    .cod-status--pending { border-color: rgba(255,193,7,0.45); }
    .cod-status--pending .cod-status__icon, .cod-status--pending .cod-status__title { color: #ffc94d; }

    .cod-status--success { border-color: rgba(40,167,69,0.45); }
    .cod-status--success .cod-status__icon, .cod-status--success .cod-status__title { color: #5cd47a; }

    .cod-status--danger { border-color: rgba(220,53,69,0.45); }
    .cod-status--danger .cod-status__icon, .cod-status--danger .cod-status__title { color: #ff7b87; }
</style>
