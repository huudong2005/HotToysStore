@model IEnumerable<ToyStore.Domain.Entities.Order>

@{
    ViewData["Title"] = "Đơn hàng của tôi";

    (string label, string css) StatusBadge(string? status) => status switch
    {
        "Pending" => ("Chờ xác nhận", "mo-badge--pending"),
        "Confirmed" => ("Đã xác nhận", "mo-badge--success"),
        "Processing" => ("Đang xử lý", "mo-badge--info"),
        "Shipped" => ("Đang giao", "mo-badge--primary"),
        "Delivered" => ("Đã giao", "mo-badge--success"),
        "Cancelled" => ("Đã hủy", "mo-badge--danger"),
        _ => (string.IsNullOrEmpty(status) ? "Không rõ" : status, "mo-badge--secondary")
    };
}

<div class="container my-orders">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <h2 class="mb-0"><i class="fas fa-receipt me-2"></i> Đơn hàng của tôi</h2>
        <a href="/" class="btn btn-outline-light">
            <i class="fas fa-shopping-bag me-2"></i> Tiếp tục mua sắm
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var order in Model)
            {
                var badge = StatusBadge(order.Status);
                var itemCount = order.OrderDetails?.Sum(d => d.Quantity) ?? 0;
                <div class="col-lg-6">
                    <div class="mo-card">
                        <div class="mo-card__head">
                            <div class="mo-card__id">
                                <i class="fas fa-box me-2"></i>Đơn hàng <span>#@order.OrderId</span>
                            </div>
                            <span class="mo-badge @badge.css">@badge.label</span>
                        </div>

                        <div class="mo-card__meta">
                            <div class="mo-meta">
                                <span class="mo-meta__label"><i class="far fa-clock me-1"></i>Ngày đặt</span>
                                <span class="mo-meta__value">@(order.OrderDate?.ToString("dd/MM/yyyy HH:mm") ?? "—")</span>
                            </div>
                            <div class="mo-meta text-end">
                                <span class="mo-meta__label">Tổng tiền</span>
                                <span class="mo-meta__total">@order.TotalAmount.ToString("#,##0") ₫</span>
                            </div>
                        </div>

                        <div class="mo-card__products">
                            <div class="mo-products__title">
                                <i class="fas fa-box-open me-1"></i>Sản phẩm (@itemCount)
                            </div>
                            @if (order.OrderDetails != null && order.OrderDetails.Any())
                            {
                                @foreach (var detail in order.OrderDetails.Take(3))
                                {
                                    <div class="mo-product-line">
                                        <span class="mo-product-line__name">
                                            @(detail.Product?.ProductName ?? "Sản phẩm không tồn tại")
                                            <span class="mo-product-line__qty">×@detail.Quantity</span>
                                        </span>
                                        <span class="mo-product-line__price">@((detail.UnitPrice * detail.Quantity).ToString("#,##0")) ₫</span>
                                    </div>
                                }
                                @if (order.OrderDetails.Count > 3)
                                {
                                    <div class="mo-product-more">và @(order.OrderDetails.Count - 3) sản phẩm khác…</div>
                                }
                            }
                            else
                            {
                                <div class="mo-product-more">Không có sản phẩm.</div>
                            }
                        </div>

                        <div class="mo-card__foot">
                            <a href="/Order/Details/@order.OrderId" class="btn btn-sm btn-outline-light">
                                <i class="fas fa-eye me-1"></i> Xem chi tiết
                            </a>
                            @if (order.Status == "Pending")
                            {
                                <form action="/Order/Cancel/@order.OrderId" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này?')">
                                        <i class="fas fa-times me-1"></i> Hủy đơn
                                    </button>
                                </form>
                            }
                            else if (order.Status == "Confirmed")
                            {
                                <span class="mo-confirmed"><i class="fas fa-check-circle me-1"></i>Đã được xác nhận</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 my-orders__empty">
            <i class="fas fa-receipt fa-4x mb-4"></i>
            <h4>Chưa có đơn hàng nào</h4>
            <p>Hãy đặt hàng để xem lịch sử mua sắm của bạn</p>
            <a href="/" class="btn btn-outline-light btn-lg mt-2">
                <i class="fas fa-shopping-bag me-2"></i> Mua sắm ngay
            </a>
        </div>
    }
</div>

<style>
    .my-orders { color: var(--lux-white, #fff); }

    .my-orders h2 {
        font-family: 'Montserrat', sans-serif;
        font-weight: 300;
        letter-spacing: 0.08em;
    }

    /* ===== Card đơn hàng ===== */
    .mo-card {
        background: var(--lux-surface, #111);
        border: 1px solid var(--lux-line, rgba(255,255,255,0.12));
        border-radius: 6px;
        padding: 1.25rem 1.4rem;
        height: 100%;
        display: flex;
        flex-direction: column;
        transition: border-color 0.3s ease, transform 0.3s ease;
    }

    .mo-card:hover {
        border-color: rgba(255,255,255,0.45);
        transform: translateY(-3px);
    }

    .mo-card__head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 0.9rem;
        border-bottom: 1px solid var(--lux-line, rgba(255,255,255,0.12));
    }

    .mo-card__id {
        font-family: 'Montserrat', sans-serif;
        font-weight: 500;
        letter-spacing: 0.04em;
        color: var(--lux-white, #fff);
    }

    .mo-card__id span { color: var(--lux-muted, #b3b3b3); }

    /* Badge trạng thái */
    .mo-badge {
        font-size: 0.72rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding: 0.4rem 0.8rem;
        border-radius: 999px;
        white-space: nowrap;
    }

    .mo-badge--pending { background: rgba(255,193,7,0.15); color: #ffc94d; border: 1px solid rgba(255,193,7,0.5); }
    .mo-badge--success { background: rgba(40,167,69,0.15); color: #5cd47a; border: 1px solid rgba(40,167,69,0.5); }
    .mo-badge--info { background: rgba(23,162,184,0.15); color: #4fd0e3; border: 1px solid rgba(23,162,184,0.5); }
    .mo-badge--primary { background: rgba(74,144,255,0.15); color: #7eacff; border: 1px solid rgba(74,144,255,0.5); }
    .mo-badge--danger { background: rgba(220,53,69,0.15); color: #ff7b87; border: 1px solid rgba(220,53,69,0.5); }
    .mo-badge--secondary { background: rgba(255,255,255,0.08); color: #b3b3b3; border: 1px solid rgba(255,255,255,0.25); }

    /* Meta: ngày đặt + tổng tiền */
    .mo-card__meta {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem 0;
        border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .mo-meta { display: flex; flex-direction: column; gap: 0.25rem; }

    .mo-meta__label {
        color: var(--lux-faint, #808080);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .mo-meta__value { color: var(--lux-white, #fff); font-size: 0.95rem; }

    .mo-meta__total {
        color: var(--lux-white, #fff);
        font-family: 'Montserrat', sans-serif;
        font-weight: 600;
        font-size: 1.15rem;
    }

    /* Danh sách sản phẩm */
    .mo-card__products { padding: 1rem 0; flex: 1 1 auto; }

    .mo-products__title {
        color: var(--lux-faint, #808080);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.6rem;
    }

    .mo-product-line {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.3rem 0;
        color: var(--lux-muted, #b3b3b3);
        font-size: 0.92rem;
    }

    .mo-product-line__name { color: #d9d9d9; }
    .mo-product-line__qty { color: var(--lux-faint, #808080); margin-left: 0.25rem; }
    .mo-product-line__price { color: var(--lux-white, #fff); white-space: nowrap; }

    .mo-product-more {
        color: var(--lux-faint, #808080);
        font-size: 0.82rem;
        font-style: italic;
        margin-top: 0.35rem;
    }

    /* Footer hành động */
    .mo-card__foot {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.75rem;
        padding-top: 0.9rem;
        border-top: 1px solid var(--lux-line, rgba(255,255,255,0.12));
    }

    .mo-confirmed { color: #5cd47a; font-size: 0.88rem; }

    /* Empty state */
    .my-orders__empty { color: var(--lux-muted, #b3b3b3); }
    .my-orders__empty i { color: var(--lux-faint, #808080); }
    .my-orders__empty h4 { color: var(--lux-white, #fff); font-weight: 300; letter-spacing: 0.06em; }
</style>
