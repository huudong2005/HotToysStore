@model IEnumerable<ToyStore.Domain.Entities.Category>

@{
    ViewData["Title"] = "Quản lý danh mục";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-tags me-2"></i> Quản lý danh mục</h2>
    <div class="d-flex align-items-center gap-3">
        <form asp-action="Index" method="get" class="d-flex align-items-center">
            <div class="search-container">
                <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" 
                       class="form-control search-input" placeholder="Tìm kiếm danh mục..." />
                <button type="submit" class="btn btn-outline-primary search-btn">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </form>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createCategoryModal">
            <i class="fas fa-plus me-2"></i> Thêm danh mục mới
        </button>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card categories-main-card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover categories-table">
                    <thead class="table-dark">
                        <tr>
                            <th><i class="fas fa-hashtag me-2"></i>ID</th>
                            <th><i class="fas fa-tag me-2"></i>Tên danh mục</th>
                            <th><i class="fas fa-box me-2"></i>Số sản phẩm</th>                           
                            <th><i class="fas fa-cogs me-2"></i>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="category-row">
                                <td>
                                    <span class="badge bg-primary category-id-badge">#@item.CategoryId</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="category-icon me-3">
                                            <i class="fas fa-tag"></i>
                                        </div>
                                        <div>
                                            <strong class="category-name">@item.CategoryName</strong>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-info product-count-badge">@item.Products.Count() sản phẩm</span>
                                </td>
                                
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@item.CategoryId" class="btn btn-sm btn-info" title="Xem chi tiết">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-warning" title="Sửa"
                                                data-bs-toggle="modal" data-bs-target="#editCategoryModal-@item.CategoryId">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <a asp-action="Delete" asp-route-id="@item.CategoryId" class="btn btn-sm btn-danger" title="Xóa">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 categories-empty-state">
                <i class="fas fa-tags categories-empty-icon"></i>
                <h5 class="categories-empty-title">Chưa có danh mục nào</h5>
                <p class="categories-empty-text">Hãy thêm danh mục đầu tiên để bắt đầu quản lý sản phẩm</p>
                <button type="button" class="btn btn-primary categories-empty-btn" data-bs-toggle="modal" data-bs-target="#createCategoryModal">
                    <i class="fas fa-plus me-2"></i>Thêm danh mục
                </button>
            </div>
        }
    </div>
</div>

<!-- ===== Modal: Thêm danh mục mới ===== -->
<div class="modal fade" id="createCategoryModal" tabindex="-1" aria-labelledby="createCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content category-modal">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="createCategoryModalLabel">
                        <i class="fas fa-plus-circle me-2"></i> Thêm danh mục mới
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label for="create-CategoryName" class="form-label">Tên danh mục</label>
                        <input type="text" name="CategoryName" id="create-CategoryName" class="form-control"
                               placeholder="Nhập tên danh mục..." required maxlength="100" autocomplete="off" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-1"></i> Hủy
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Lưu danh mục
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ===== Modal: Cập nhật danh mục (mỗi danh mục một modal) ===== -->
@foreach (var item in Model)
{
    <div class="modal fade" id="editCategoryModal-@item.CategoryId" tabindex="-1"
         aria-labelledby="editCategoryModalLabel-@item.CategoryId" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content category-modal">
                <form asp-action="Edit" asp-route-id="@item.CategoryId" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="CategoryId" value="@item.CategoryId" />
                    <div class="modal-header">
                        <h5 class="modal-title" id="editCategoryModalLabel-@item.CategoryId">
                            <i class="fas fa-edit me-2"></i> Cập nhật danh mục #@item.CategoryId
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
                    </div>
                    <div class="modal-body">
                        <div class="form-group">
                            <label for="edit-CategoryName-@item.CategoryId" class="form-label">Tên danh mục</label>
                            <input type="text" name="CategoryName" id="edit-CategoryName-@item.CategoryId"
                                   class="form-control" value="@item.CategoryName"
                                   placeholder="Nhập tên danh mục..." required maxlength="100" autocomplete="off" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="fas fa-times me-1"></i> Hủy
                        </button>
                        <button type="submit" class="btn btn-warning">
                            <i class="fas fa-save me-1"></i> Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<style>
    /* ===== Category Modal - Luxury ===== */
    .category-modal {
        background: var(--lux-bg, #0a0a0a) !important;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.12)) !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        color: var(--lux-white, #fff) !important;
    }

    .category-modal .modal-header {
        border-bottom: 1px solid var(--lux-line, rgba(255,255,255,0.12));
    }

    .category-modal .modal-footer {
        border-top: 1px solid var(--lux-line, rgba(255,255,255,0.12));
    }

    .category-modal .modal-title {
        color: var(--lux-white, #fff) !important;
        font-family: 'Montserrat', sans-serif;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    .category-modal .form-label {
        color: var(--lux-muted, #b3b3b3) !important;
        font-family: 'Montserrat', sans-serif;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-size: 0.78rem;
        margin-bottom: 0.5rem;
    }

    .category-modal .form-control {
        background-color: transparent !important;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.12)) !important;
        border-radius: 0 !important;
        color: var(--lux-white, #fff) !important;
    }

    .category-modal .form-control::placeholder {
        color: var(--lux-faint, #808080) !important;
    }

    .category-modal .form-control:focus {
        border-color: var(--lux-white, #fff) !important;
        box-shadow: none !important;
    }

    .category-modal .btn-secondary {
        background: transparent !important;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.25)) !important;
        color: var(--lux-muted, #b3b3b3) !important;
    }

    .category-modal .btn-secondary:hover {
        background: var(--lux-white, #fff) !important;
        color: #000 !important;
    }

    /* ===== Categories Page - Luxury ===== */
    .categories-main-card {
        background: var(--lux-surface, #111) !important;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.12)) !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        color: var(--lux-white, #fff) !important;
    }

    .categories-table th {
        border-top: none;
        font-family: 'Montserrat', sans-serif;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        background: transparent !important;
        color: var(--lux-white, #fff) !important;
        padding: 1rem 0.75rem;
        font-size: 0.85rem;
        border-bottom: 1px solid var(--lux-line, rgba(255,255,255,0.12)) !important;
    }

    .categories-table td {
        vertical-align: middle;
        color: var(--lux-white, #fff) !important;
        padding: 1rem 0.75rem;
        border-color: var(--lux-line-soft, rgba(255,255,255,0.06)) !important;
    }

    .category-row {
        transition: all 0.3s ease;
    }

    .category-row:hover {
        background-color: rgba(255, 255, 255, 0.05) !important;
        transform: none;
    }

    .table-striped > tbody > tr:nth-of-type(odd) > td {
        background-color: rgba(255, 255, 255, 0.02) !important;
    }

    .category-icon {
        width: 40px;
        height: 40px;
        background: transparent;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.25));
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--lux-white, #fff);
        font-size: 1rem;
        box-shadow: none;
    }

    .category-name {
        color: var(--lux-white, #fff) !important;
        font-weight: 500;
        font-size: 1rem;
    }

    .category-date {
        color: var(--lux-muted, #b3b3b3) !important;
        font-size: 0.9rem;
    }

    .category-id-badge,
    .product-count-badge {
        font-weight: 600;
        font-size: 0.85rem;
        padding: 0.5rem 0.75rem;
    }

    .btn-group .btn {
        margin-right: 3px;
        border-radius: 0.5rem;
        padding: 0.5rem 0.75rem;
    }

    .btn-group .btn:last-child {
        margin-right: 0;
    }

    /* Mọi nút thao tác -> Ghost trắng */
    .btn-info,
    .btn-warning,
    .btn-danger,
    .btn-primary {
        background: transparent !important;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.25)) !important;
        color: var(--lux-white, #fff) !important;
        border-radius: 0 !important;
        font-family: 'Montserrat', sans-serif;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        box-shadow: none !important;
        transition: all 0.4s ease;
    }

    .btn-info:hover,
    .btn-warning:hover,
    .btn-danger:hover,
    .btn-primary:hover {
        background: var(--lux-white, #fff) !important;
        color: #000 !important;
        border-color: var(--lux-white, #fff) !important;
        transform: none;
        box-shadow: none !important;
    }

    .btn-primary {
        padding: 0.75rem 1.5rem;
    }

    .alert-success,
    .alert-danger {
        background: var(--lux-surface, #111) !important;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.12)) !important;
        color: var(--lux-white, #fff) !important;
        border-radius: 0 !important;
    }
    .alert-success { border-left: 2px solid var(--lux-white, #fff) !important; }
    .alert-danger { border-left: 2px solid var(--lux-muted, #b3b3b3) !important; }

    .categories-empty-state {
        background: transparent;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.12));
        border-radius: 0;
        box-shadow: none;
        padding: 4rem 2rem !important;
    }

    .categories-empty-icon {
        color: var(--lux-muted, #b3b3b3) !important;
        font-size: 4rem !important;
        margin-bottom: 1.5rem;
    }

    .categories-empty-title {
        color: var(--lux-white, #fff) !important;
        font-size: 1.4rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 1rem;
    }

    .categories-empty-text {
        color: var(--lux-muted, #b3b3b3) !important;
        font-size: 1rem;
        margin-bottom: 2rem;
    }

    .categories-empty-btn {
        background: transparent !important;
        color: var(--lux-white, #fff) !important;
        border: 1px solid var(--lux-white, #fff) !important;
        font-family: 'Montserrat', sans-serif;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        padding: 0.75rem 2rem;
        border-radius: 0;
        transition: all 0.4s ease;
    }

    .categories-empty-btn:hover {
        background: var(--lux-white, #fff) !important;
        color: #000 !important;
        transform: none;
        box-shadow: none !important;
    }

    /* Search Styles */
    .search-container {
        position: relative;
        display: flex;
        align-items: center;
        background: transparent;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.12));
        border-radius: 0;
        padding: 0.25rem;
        box-shadow: none;
        transition: border-color 0.4s ease;
    }

    .search-container:focus-within {
        box-shadow: none;
        border-color: var(--lux-white, #fff);
    }

    .search-input {
        background: transparent !important;
        border: none !important;
        color: var(--lux-white, #fff) !important;
        padding: 0.5rem 1rem;
        width: 250px;
        font-size: 0.95rem;
        outline: none;
    }

    .search-input::placeholder {
        color: var(--lux-faint, #808080) !important;
        opacity: 1;
    }

    .search-input:focus {
        box-shadow: none !important;
    }

    .search-btn {
        background: transparent !important;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.25)) !important;
        color: var(--lux-white, #fff) !important;
        padding: 0.5rem 0.85rem;
        border-radius: 0;
        margin-left: 0.5rem;
        transition: all 0.4s ease;
    }

    .search-btn:hover {
        background: var(--lux-white, #fff) !important;
        transform: none;
        box-shadow: none !important;
        color: #000 !important;
    }

    .search-btn:focus {
        box-shadow: none !important;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .d-flex.justify-content-between {
            flex-direction: column;
            gap: 1rem;
            text-align: center;
        }
        
        .d-flex.align-items-center.gap-3 {
            flex-direction: column;
            gap: 1rem !important;
        }
        
        .search-container {
            width: 100%;
            max-width: 300px;
        }
        
        .search-input {
            width: 100%;
        }
        
        .btn-group {
            flex-direction: column;
            gap: 0.5rem;
        }
        
        .btn-group .btn {
            margin-right: 0;
            width: 100%;
        }
        
        .category-icon {
            width: 35px;
            height: 35px;
            font-size: 0.9rem;
        }
        
        .categories-empty-state {
            padding: 2rem 1rem !important;
        }
        
        .categories-empty-icon {
            font-size: 3rem !important;
        }
    }
</style>
