@model ToyStore.Domain.Entities.Product

@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}

<div class="crud-theme">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0"><i class="fas fa-edit me-2"></i>Chỉnh sửa sản phẩm</h4>
                </div>
                <div class="card-body">
                    <form asp-controller="Products" asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="ProductId" />

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Tên sản phẩm *</label>
                                    <input asp-for="ProductName" class="form-control" placeholder="Nhập tên sản phẩm" required />
                                    <span asp-validation-for="ProductName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Danh mục *</label>
                                    <select asp-for="CategoryId" id="categorySelect" class="form-select" required>
                                        @foreach (var category in ViewBag.Categories as List<ToyStore.Domain.Entities.Category>)
                                        {
                                            <option value="@category.CategoryId">@category.CategoryName</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Mô tả</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Nhập mô tả sản phẩm"></textarea>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label class="form-label">Giá bán (₫) *</label>
                                    <input asp-for="Price" type="number" class="form-control" step="1000" min="0" required />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label class="form-label">Số lượng tồn kho *</label>
                                    <input asp-for="Stock" type="number" class="form-control" min="0" required />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label class="form-label">Trạng thái</label>
                                    <select asp-for="Status" class="form-select">
                                        <option value="true">Đang bán</option>
                                        <option value="false">Ngừng bán</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">URL hình ảnh</label>
                            <input asp-for="ImageUrl" class="form-control" placeholder="https://example.com/image.jpg" />
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                            <button type="submit" class="btn btn-warning text-dark">
                                <i class="fas fa-save"></i> Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* ===== Chỉnh sửa sản phẩm - Luxury dark ===== */
    .crud-theme .card {
        background: var(--lux-surface, #111) !important;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.12)) !important;
        border-radius: 8px !important;
        box-shadow: none !important;
    }

    .crud-theme .card-header {
        background: transparent !important;
        border-bottom: 1px solid var(--lux-line, rgba(255,255,255,0.12)) !important;
        padding: 1.1rem 1.5rem;
    }

    .crud-theme .card-header h4 {
        font-family: 'Montserrat', sans-serif;
        font-weight: 300;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--lux-white, #fff) !important;
    }

    .crud-theme .card-body { padding: 1.75rem; }

    .crud-theme .form-label {
        color: var(--lux-muted, #b3b3b3) !important;
        font-family: 'Montserrat', sans-serif;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-size: 0.74rem;
        font-weight: 500;
    }

    .crud-theme .form-control,
    .crud-theme .form-select {
        background: #0d0d0d !important;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.14)) !important;
        border-radius: 4px !important;
        color: var(--lux-white, #fff) !important;
    }

    .crud-theme .form-control::placeholder { color: var(--lux-faint, #808080) !important; }

    .crud-theme .form-control:focus,
    .crud-theme .form-select:focus {
        background: #0d0d0d !important;
        border-color: rgba(255,255,255,0.55) !important;
        box-shadow: none !important;
        color: var(--lux-white, #fff) !important;
    }

    /* FIX: option của dropdown native - nền tối, chữ trắng để đọc rõ */
    .crud-theme select.form-select option {
        background-color: #111 !important;
        color: #fff !important;
    }

    .crud-theme select.form-select option:checked,
    .crud-theme select.form-select option:hover {
        background-color: #1f1f1f !important;
        color: #fff !important;
    }

    /* Select2 (Danh mục) đồng bộ tông tối */
    .select2-container--bootstrap-5 .select2-selection {
        background-color: #0d0d0d !important;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.14)) !important;
        border-radius: 4px !important;
    }

    .select2-container--bootstrap-5 .select2-selection__rendered,
    .select2-container--bootstrap-5 .select2-selection__placeholder {
        color: #fff !important;
    }

    .select2-container--bootstrap-5 .select2-dropdown,
    .select2-dropdown {
        background-color: #111 !important;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.18)) !important;
    }

    .select2-container--bootstrap-5 .select2-results__option {
        color: #b3b3b3 !important;
        background-color: #111 !important;
    }

    .select2-container--bootstrap-5 .select2-results__option--highlighted,
    .select2-container--bootstrap-5 .select2-results__option[aria-selected="true"] {
        background-color: #1f1f1f !important;
        color: #fff !important;
    }

    .select2-search--dropdown .select2-search__field {
        background-color: #0d0d0d !important;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.18)) !important;
        color: #fff !important;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#categorySelect').select2({
                theme: "bootstrap-5",
                dropdownParent: $('#categorySelect').parent()
            });
        });
    </script>
}