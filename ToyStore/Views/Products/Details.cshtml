@model ToyStore.Domain.Entities.Product

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
    var (stockLabel, stockCss) = Model.Stock > 10
        ? ("Còn hàng", "pd-chip--success")
        : Model.Stock > 0 ? ("Sắp hết", "pd-chip--warning") : ("Hết hàng", "pd-chip--danger");
    var priceHistories = ViewBag.PriceHistories as IEnumerable<ToyStore.Domain.Entities.ProductPriceHistory>
        ?? Enumerable.Empty<ToyStore.Domain.Entities.ProductPriceHistory>();
    var chartLabelsJson = ViewBag.PriceChartLabelsJson as string ?? "[]";
    var chartDataJson = ViewBag.PriceChartDataJson as string ?? "[]";
    var hasPriceHistory = priceHistories.Any();
}

<div class="pd container">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <h2 class="mb-0"><i class="fas fa-box-open me-2"></i>Chi tiết sản phẩm</h2>
        <a href="/Products" class="btn btn-outline-light"><i class="fas fa-arrow-left me-1"></i>Quay lại</a>
    </div>

    <div class="pd-card">
        <div class="row g-0">
            <!-- Ảnh sản phẩm -->
            <div class="col-lg-5">
                <div class="pd-media">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.ProductName" class="pd-media__img" />
                    }
                    else
                    {
                        <div class="pd-media__empty">
                            <i class="fas fa-image fa-3x mb-2"></i>
                            <p class="mb-0">Chưa có hình ảnh</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Thông tin -->
            <div class="col-lg-7">
                <div class="pd-body">
                    <span class="pd-category">@(Model.Category?.CategoryName ?? "Chưa phân loại")</span>
                    <h3 class="pd-title">@Model.ProductName</h3>

                    <div class="pd-price-row">
                        <span class="pd-price">@Model.Price.ToString("#,##0") ₫</span>
                        <span class="pd-chip @stockCss">@stockLabel · @Model.Stock</span>
                    </div>

                    <div class="pd-fields">
                        <div class="pd-field">
                            <span class="pd-field__label">Mã sản phẩm</span>
                            <span class="pd-field__value">#@Model.ProductId</span>
                        </div>
                        <div class="pd-field">
                            <span class="pd-field__label">Trạng thái</span>
                            <span class="pd-field__value">
                                @if (Model.Status == true)
                                {
                                    <span class="pd-chip pd-chip--success">Đang bán</span>
                                }
                                else
                                {
                                    <span class="pd-chip pd-chip--secondary">Ngừng bán</span>
                                }
                            </span>
                        </div>
                        <div class="pd-field">
                            <span class="pd-field__label">Tồn kho</span>
                            <span class="pd-field__value">@Model.Stock sản phẩm</span>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <div class="pd-field">
                                <span class="pd-field__label">Hình ảnh</span>
                                <span class="pd-field__value">
                                    <a href="@Model.ImageUrl" target="_blank" class="pd-link">
                                        <i class="fas fa-external-link-alt me-1"></i>Xem ảnh gốc
                                    </a>
                                </span>
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="pd-desc">
                            <span class="pd-field__label">Mô tả</span>
                            <p class="pd-desc__text">@Model.Description</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Lịch sử biến động giá -->
    <div class="pd-card pd-price-history mt-4">
        <div class="pd-history-header">
            <h4 class="pd-history-title">
                <i class="fas fa-chart-line me-2"></i> Lịch sử biến động giá
            </h4>
            <span class="pd-history-badge">@priceHistories.Count() thay đổi</span>
        </div>

        <div class="pd-history-body">
            @if (hasPriceHistory)
            {
                <div class="pd-chart-wrap">
                    <canvas id="priceHistoryChart"></canvas>
                </div>

                <div class="table-responsive mt-4">
                    <table class="table pd-history-table mb-0">
                        <thead>
                            <tr>
                                <th>Thời gian</th>
                                <th class="text-end">Giá cũ</th>
                                <th class="text-end">Giá mới</th>
                                <th class="text-end">Chênh lệch</th>
                                <th>Người cập nhật</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in priceHistories.OrderByDescending(h => h.ChangedAt))
                            {
                                var diff = row.NewPrice - row.OldPrice;
                                var diffCss = diff > 0 ? "pd-diff--up" : diff < 0 ? "pd-diff--down" : "";
                                var adminName = row.Admin?.FullName ?? row.Admin?.Username ?? $"Admin #{row.AdminId}";
                                <tr>
                                    <td>@row.ChangedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-end">@row.OldPrice.ToString("#,##0") ₫</td>
                                    <td class="text-end fw-semibold">@row.NewPrice.ToString("#,##0") ₫</td>
                                    <td class="text-end @diffCss">
                                        @(diff >= 0 ? "+" : "")@diff.ToString("#,##0") ₫
                                    </td>
                                    <td>@adminName</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="pd-history-empty">
                    <i class="fas fa-chart-area fa-2x mb-2"></i>
                    <p class="mb-0">Chưa có lịch sử thay đổi giá. Biểu đồ sẽ hiển thị sau lần chỉnh sửa giá đầu tiên.</p>
                </div>
            }
        </div>
    </div>

    <!-- Hành động -->
    <div class="d-flex justify-content-between mt-4">
        <a href="/Products" class="btn btn-outline-light"><i class="fas fa-arrow-left me-1"></i>Quay lại</a>
        <div class="d-flex gap-2">
            <a href="/Products/Edit/@Model.ProductId" class="btn btn-warning"><i class="fas fa-edit me-1"></i>Sửa sản phẩm</a>
            <a href="/Products/Delete/@Model.ProductId" class="btn btn-outline-danger"><i class="fas fa-trash me-1"></i>Xóa sản phẩm</a>
        </div>
    </div>
</div>

<style>
    .pd { color: var(--lux-white, #fff); }

    .pd h2 { font-family: 'Montserrat', sans-serif; font-weight: 300; letter-spacing: 0.08em; }

    .pd-card {
        background: var(--lux-surface, #111);
        border: 1px solid var(--lux-line, rgba(255,255,255,0.12));
        border-radius: 8px;
        overflow: hidden;
    }

    /* Ảnh */
    .pd-media {
        height: 100%;
        min-height: 340px;
        background: #0d0d0d;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        border-right: 1px solid var(--lux-line, rgba(255,255,255,0.08));
    }

    .pd-media__img {
        max-width: 100%;
        max-height: 380px;
        object-fit: contain;
        border-radius: 4px;
    }

    .pd-media__empty {
        text-align: center;
        color: var(--lux-faint, #808080);
    }

    /* Thông tin */
    .pd-body { padding: 2rem; }

    .pd-category {
        display: inline-block;
        font-family: 'Montserrat', sans-serif;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        font-size: 0.72rem;
        color: var(--lux-faint, #808080);
        margin-bottom: 0.5rem;
    }

    .pd-title {
        font-family: 'Montserrat', sans-serif;
        font-weight: 400;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--lux-white, #fff);
        font-size: 1.6rem;
        line-height: 1.3;
        margin-bottom: 1.25rem;
    }

    .pd-price-row {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding-bottom: 1.25rem;
        margin-bottom: 1.25rem;
        border-bottom: 1px solid var(--lux-line, rgba(255,255,255,0.12));
    }

    .pd-price {
        font-family: 'Montserrat', sans-serif;
        font-weight: 600;
        font-size: 1.6rem;
        color: var(--lux-white, #fff);
    }

    /* Chip trạng thái/tồn kho */
    .pd-chip {
        font-size: 0.74rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding: 0.35rem 0.8rem;
        border-radius: 999px;
        white-space: nowrap;
    }

    .pd-chip--success { background: rgba(40,167,69,0.15); color: #5cd47a; border: 1px solid rgba(40,167,69,0.5); }
    .pd-chip--warning { background: rgba(255,193,7,0.15); color: #ffc94d; border: 1px solid rgba(255,193,7,0.5); }
    .pd-chip--danger { background: rgba(220,53,69,0.15); color: #ff7b87; border: 1px solid rgba(220,53,69,0.5); }
    .pd-chip--secondary { background: rgba(255,255,255,0.08); color: #b3b3b3; border: 1px solid rgba(255,255,255,0.25); }

    /* Hàng thông tin */
    .pd-fields { display: flex; flex-direction: column; }

    .pd-field {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: 0.6rem 0;
        border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .pd-field__label {
        color: var(--lux-faint, #808080);
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .pd-field__value { color: var(--lux-white, #fff); text-align: right; }

    .pd-link { color: var(--lux-white, #fff); text-decoration: underline; }
    .pd-link:hover { color: var(--lux-muted, #b3b3b3); }

    /* Mô tả */
    .pd-desc { margin-top: 1.25rem; }
    .pd-desc__text {
        color: var(--lux-muted, #b3b3b3);
        margin-top: 0.5rem;
        line-height: 1.7;
    }

    /* Lịch sử giá */
    .pd-price-history { padding: 0; }

    .pd-history-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--lux-line, rgba(255,255,255,0.12));
    }

    .pd-history-title {
        font-family: 'Montserrat', sans-serif;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.95rem;
        margin: 0;
        color: var(--lux-white, #fff);
    }

    .pd-history-badge {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        padding: 0.35rem 0.75rem;
        border: 1px solid rgba(0, 255, 255, 0.35);
        color: #00e5ff;
        background: rgba(0, 229, 255, 0.08);
    }

    .pd-history-body { padding: 1.5rem; }

    .pd-chart-wrap {
        position: relative;
        height: 320px;
        background: rgba(0, 0, 0, 0.35);
        border: 1px solid rgba(0, 255, 255, 0.15);
        padding: 1rem;
    }

    .pd-history-table {
        color: var(--lux-white, #fff);
        font-size: 0.875rem;
    }

    .pd-history-table thead th {
        font-family: 'Montserrat', sans-serif;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        font-size: 0.72rem;
        color: var(--lux-faint, #808080);
        border-bottom: 1px solid var(--lux-line, rgba(255,255,255,0.12));
    }

    .pd-history-table tbody td {
        border-bottom: 1px solid rgba(255,255,255,0.06);
        vertical-align: middle;
    }

    .pd-diff--up { color: #ff6b6b; }
    .pd-diff--down { color: #5cd47a; }

    .pd-history-empty {
        text-align: center;
        padding: 2.5rem 1rem;
        color: var(--lux-faint, #808080);
    }
</style>

@if (hasPriceHistory)
{
    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
        <script>
            (function () {
                const labels = @Html.Raw(chartLabelsJson);
                const prices = @Html.Raw(chartDataJson);
                const canvas = document.getElementById('priceHistoryChart');
                if (!canvas || !labels.length) return;

                const ctx = canvas.getContext('2d');
                const neonCyan = '#00e5ff';
                const neonGold = '#ffd166';
                const gridColor = 'rgba(255, 255, 255, 0.08)';

                const gradient = ctx.createLinearGradient(0, 0, 0, 320);
                gradient.addColorStop(0, 'rgba(0, 229, 255, 0.35)');
                gradient.addColorStop(1, 'rgba(0, 229, 255, 0.02)');

                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Giá bán (₫)',
                            data: prices,
                            borderColor: neonCyan,
                            backgroundColor: gradient,
                            pointBackgroundColor: neonGold,
                            pointBorderColor: neonCyan,
                            pointBorderWidth: 2,
                            pointRadius: 5,
                            pointHoverRadius: 7,
                            borderWidth: 2.5,
                            fill: true,
                            tension: 0.25
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: { mode: 'index', intersect: false },
                        plugins: {
                            legend: {
                                labels: { color: '#ffffff', font: { family: 'Montserrat' } }
                            },
                            tooltip: {
                                backgroundColor: 'rgba(13, 13, 13, 0.95)',
                                borderColor: 'rgba(0, 229, 255, 0.4)',
                                borderWidth: 1,
                                titleColor: '#ffd166',
                                bodyColor: '#ffffff',
                                callbacks: {
                                    label: function (ctx) {
                                        return ' ' + new Intl.NumberFormat('vi-VN').format(ctx.parsed.y) + ' ₫';
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                ticks: { color: '#b3b3b3', maxRotation: 45, minRotation: 0 },
                                grid: { color: gridColor }
                            },
                            y: {
                                ticks: {
                                    color: '#b3b3b3',
                                    callback: function (v) {
                                        return new Intl.NumberFormat('vi-VN').format(v) + ' ₫';
                                    }
                                },
                                grid: { color: gridColor }
                            }
                        }
                    }
                });
            })();
        </script>
    }
}
