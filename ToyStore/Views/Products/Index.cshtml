@model IEnumerable<ToyStore.Domain.Entities.Product>

@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-box"></i> Quản lý sản phẩm</h2>
    <div class="d-flex align-items-center gap-3">
        <form method="get" action="/Products" class="d-flex align-items-center gap-2">
            <div class="search-group">
                <input type="text" name="searchName" value="@ViewBag.SearchName" 
                       class="form-control search-input" 
                       placeholder="Tìm theo tên sản phẩm..." />
            </div>
            <div class="search-group">
                <select name="categoryId" class="form-select category-select">
                    <option value="0">-- Chọn danh mục --</option>
                    @if (ViewBag.Categories != null)
                    {
                        @foreach (var category in ViewBag.Categories)
                        {
                            <option value="@category.CategoryId" selected="@(ViewBag.CategoryId != null && ViewBag.CategoryId == category.CategoryId)">
                                @category.CategoryName
                            </option>
                        }
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-outline-light">
                <i class="fas fa-search"></i> Tìm kiếm
            </button>
            @if (!string.IsNullOrEmpty((string)ViewBag.SearchName) || (ViewBag.CategoryId != null && (int)ViewBag.CategoryId > 0))
            {
                <a href="/Products" class="btn btn-outline-secondary">
                    <i class="fas fa-times"></i> Xóa bộ lọc
                </a>
            }
        </form>
        <a href="/Products/Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Thêm sản phẩm mới
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th><i class="fas fa-image me-2"></i>Hình ảnh</th>
                            <th><i class="fas fa-box me-2"></i>Tên sản phẩm</th>
                            <th><i class="fas fa-tags me-2"></i>Danh mục</th>
                            <th><i class="fas fa-dollar-sign me-2"></i>Giá</th>
                            <th><i class="fas fa-warehouse me-2"></i>Tồn kho</th>
                            <th><i class="fas fa-toggle-on me-2"></i>Trạng thái</th>
                            <th><i class="fas fa-cogs me-2"></i>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.ProductName" class="product-thumbnail" />
                                    }
                                    else
                                    {
                                        <div class="product-thumbnail-placeholder">
                                            <i class="fas fa-image"></i>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div>
                                        <strong>@item.ProductName</strong>
                                        @if (!string.IsNullOrEmpty(item.Description))
                                        {
                                            <br><small class="text-muted">@(item.Description.Length > 50 ? item.Description.Substring(0, 50) + "..." : item.Description)</small>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@item.Category.CategoryName</span>
                                </td>
                                <td>
                                    <strong class="text-success">@item.Price.ToString("N0") ₫</strong>
                                </td>
                                <td>
                                    <span class="badge @(item.Stock > 10 ? "bg-success" : item.Stock > 0 ? "bg-warning" : "bg-danger")">
                                        @item.Stock
                                    </span>
                                </td>
                                <td>
                                    @if (item.Status == true)
                                    {
                                        <span class="badge bg-success">
                                            <i class="fas fa-check-circle me-1"></i>Đang bán
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="fas fa-pause-circle me-1"></i>Ngừng bán
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="/Products/Details/@item.ProductId" class="btn btn-sm btn-info" title="Xem chi tiết">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="/Products/Edit/@item.ProductId" class="btn btn-sm btn-warning" title="Sửa">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a href="/Products/Delete/@item.ProductId" class="btn btn-sm btn-danger" title="Xóa">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-4">
                <i class="fas fa-box fa-3x text-muted mb-3"></i>
                <h5 class="text-muted">Chưa có sản phẩm nào</h5>
                <p class="text-muted">Hãy thêm sản phẩm đầu tiên</p>
                <a href="/Products/Create" class="btn btn-primary">Thêm sản phẩm</a>
            </div>
        }
    </div>
</div>

<style>
    /* ===== Quản lý sản phẩm - Luxury Cinematic Gallery ===== */
    .product-thumbnail {
        width: 50px;
        height: 50px;
        object-fit: cover;
        border-radius: 4px;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.12));
    }

    .product-thumbnail-placeholder {
        width: 50px;
        height: 50px;
        background: var(--lux-bg, #0a0a0a);
        border: 1px solid var(--lux-line, rgba(255,255,255,0.12));
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--lux-muted, #b3b3b3);
        font-size: 1.2rem;
    }

    .table th {
        border-top: none;
        font-family: 'Montserrat', sans-serif;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        background: transparent !important;
        color: var(--lux-white, #fff) !important;
        border-bottom: 1px solid var(--lux-line, rgba(255,255,255,0.12)) !important;
    }

    .table td {
        vertical-align: middle;
        color: var(--lux-white, #fff) !important;
        border-color: var(--lux-line-soft, rgba(255,255,255,0.06)) !important;
    }

    .table-striped > tbody > tr:nth-of-type(odd) > td {
        background-color: rgba(255, 255, 255, 0.02) !important;
    }

    .table-hover > tbody > tr:hover > td {
        background-color: rgba(255, 255, 255, 0.05) !important;
    }

    .btn-group .btn { margin-right: 4px; }
    .btn-group .btn:last-child { margin-right: 0; }

    .card {
        background: var(--lux-surface, #111) !important;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.12)) !important;
        border-radius: 0 !important;
        box-shadow: none !important;
    }

    .card-body { color: var(--lux-white, #fff) !important; }

    .alert-success,
    .alert-danger {
        background: var(--lux-surface, #111) !important;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.12)) !important;
        color: var(--lux-white, #fff) !important;
        border-radius: 0 !important;
    }
    .alert-success { border-left: 2px solid var(--lux-white, #fff) !important; }
    .alert-danger { border-left: 2px solid var(--lux-muted, #b3b3b3) !important; }

    /* Mọi nút -> Ghost trắng */
    .btn-primary,
    .btn-info,
    .btn-warning,
    .btn-danger,
    .btn-outline-light,
    .btn-outline-secondary,
    .btn-sm.btn-info,
    .btn-sm.btn-warning,
    .btn-sm.btn-danger {
        background: transparent !important;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.25)) !important;
        color: var(--lux-white, #fff) !important;
        border-radius: 0 !important;
        font-family: 'Montserrat', sans-serif;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        box-shadow: none !important;
        transition: all 0.4s ease;
    }

    .btn-primary:hover,
    .btn-info:hover,
    .btn-warning:hover,
    .btn-danger:hover,
    .btn-outline-light:hover,
    .btn-outline-secondary:hover {
        background: var(--lux-white, #fff) !important;
        color: #000 !important;
        border-color: var(--lux-white, #fff) !important;
        transform: none;
        box-shadow: none !important;
    }

    /* Giá: trắng */
    .text-success { color: var(--lux-white, #fff) !important; }
    .text-muted { color: var(--lux-muted, #b3b3b3) !important; }

    /* Badge ghost */
    .badge,
    .badge.bg-secondary,
    .badge.bg-success,
    .badge.bg-warning,
    .badge.bg-danger {
        background: transparent !important;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.3)) !important;
        color: var(--lux-muted, #b3b3b3) !important;
        border-radius: 0 !important;
        font-family: 'Montserrat', sans-serif;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .search-group { position: relative; }

    .search-input,
    .category-select {
        background: transparent !important;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.12)) !important;
        border-radius: 0 !important;
        color: var(--lux-white, #fff) !important;
        padding: 0.5rem 1rem;
        min-width: 200px;
    }

    .search-input::placeholder { color: var(--lux-faint, #808080) !important; }

    .search-input:focus,
    .category-select:focus {
        background: transparent !important;
        border-color: var(--lux-white, #fff) !important;
        box-shadow: none !important;
        outline: none;
    }

    .category-select { cursor: pointer; }
    .category-select option { background: #111 !important; color: #fff !important; }

    .gap-2 { gap: 0.5rem !important; }
    .gap-3 { gap: 1rem !important; }

    @@media (max-width: 768px) {
        .d-flex.justify-content-between {
            flex-direction: column;
            align-items: flex-start !important;
        }
        .search-group .search-input,
        .search-group .category-select { min-width: 150px; }
        .d-flex.align-items-center { flex-wrap: wrap; }
    }
</style>
