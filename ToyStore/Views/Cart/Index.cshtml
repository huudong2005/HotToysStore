@model ToyStore.Models.ShoppingCart

@{
    ViewData["Title"] = "Giỏ hàng";

    // Trạng thái mã khuyến mãi (Voucher) đã áp dụng - khôi phục từ Session.
    var appliedPromoCode = ViewBag.AppliedPromoCode as string;
    decimal appliedPromoDiscount = ViewBag.AppliedDiscountValue == null ? 0m : (decimal)ViewBag.AppliedDiscountValue;
    decimal finalAfterPromo = Model.Subtotal - appliedPromoDiscount;
    if (finalAfterPromo < 0) finalAfterPromo = 0;

    Func<decimal, string> vnd = amount => amount.ToString("#,##0", System.Globalization.CultureInfo.InvariantCulture) + "đ";

    // Danh sách mã khuyến mãi đang hoạt động (truyền từ CartController qua ViewBag).
    var activePromotions = ViewBag.ActivePromotions as IEnumerable<ToyStore.Domain.Entities.Promotion>
        ?? Enumerable.Empty<ToyStore.Domain.Entities.Promotion>();
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-shopping-cart"></i> Giỏ hàng của tôi</h2>
        <div class="d-flex align-items-center">
            <span class="badge bg-primary fs-6 me-3">
                <i class="fas fa-box"></i> @Model.ItemCount sản phẩm
            </span>
            <a href="/" class="btn btn-outline-primary">
                <i class="fas fa-arrow-left"></i> Tiếp tục mua sắm
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Items.Any())
    {
        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Danh sách sản phẩm</h5>
                    </div>
                    <div class="card-body">
                        @foreach (var item in Model.Items)
                        {
                            <div class="row align-items-center g-2 py-3 border-bottom cart-item-row">
                                <div class="col-2">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.ProductName" class="img-fluid rounded" style="max-height: 70px; object-fit: cover;">
                                    }
                                    else
                                    {
                                        <div class="bg-light d-flex align-items-center justify-content-center rounded" style="height: 70px;">
                                            <i class="fas fa-image text-muted"></i>
                                        </div>
                                    }
                                </div>
                                <div class="col-4">
                                    <h6 class="mb-1 text-truncate">@item.ProductName</h6>
                                    <p class="text-success mb-0 fw-bold">@item.Price.ToString("N0") ₫</p>
                                </div>
                                <div class="col-3">
                                    <div class="d-flex align-items-center flex-nowrap justify-content-center gap-1 cart-qty-controls">
                                        <button type="button" class="btn btn-sm btn-outline-secondary cart-qty-btn" onclick="changeQuantity(@item.ProductId, @item.Quantity - 1)">-</button>
                                        <input type="number" id="quantity-@item.ProductId" value="@item.Quantity" min="1" max="999" class="form-control form-control-sm text-center p-1 cart-qty-input" readonly />
                                        <button type="button" class="btn btn-sm btn-outline-secondary cart-qty-btn" onclick="changeQuantity(@item.ProductId, @item.Quantity + 1)">+</button>
                                    </div>
                                </div>
                                <div class="col-2 text-end">
                                    <p class="text-success mb-0 fw-bold text-nowrap">@item.Total.ToString("N0") ₫</p>
                                </div>
                                <div class="col-1 text-end">
                                    <form action="/Cart/Remove" method="post" class="d-inline">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger cart-remove-btn" title="Xóa sản phẩm">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Tóm tắt đơn hàng</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tạm tính:</span>
                            <span>@Model.Subtotal.ToString("N0") ₫</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Phí vận chuyển:</span>
                            <span class="text-success">Miễn phí</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-3">
                            <strong>Tổng cộng:</strong>
                            <strong class="text-success">@Model.Subtotal.ToString("N0") ₫</strong>
                        </div>

                        <!-- ====== Mã khuyến mãi (Voucher) ====== -->
                        <div class="mb-3">
                            <label class="form-label fw-bold" for="promoCodeInput">Mã khuyến mãi</label>
                            <div class="input-group">
                                <input type="text" id="promoCodeInput" class="form-control"
                                       placeholder="Nhập mã khuyến mãi" value="@appliedPromoCode" />
                                <button type="button" id="applyPromoBtn" class="btn btn-outline-primary">
                                    <i class="fas fa-tag"></i> Áp dụng mã
                                </button>
                            </div>
                            <small id="promoMessage" class="d-block mt-2 text-muted"></small>

                            @if (activePromotions.Any())
                            {
                                <div class="available-vouchers mt-3">
                                    <div class="available-vouchers__title">
                                        <i class="fas fa-ticket-alt"></i> Mã khuyến mãi đang hoạt động
                                    </div>
                                    <div class="voucher-scroll">
                                        @foreach (var promo in activePromotions)
                                        {
                                            <div class="voucher-ticket">
                                                <div class="voucher-ticket__info">
                                                    <span class="voucher-ticket__code">@promo.PromotionCode</span>
                                                    <span class="voucher-ticket__cond">
                                                        @if (promo.MinOrderValue > 0)
                                                        {
                                                            <text>Đơn tối thiểu @vnd(promo.MinOrderValue)</text>
                                                        }
                                                        else
                                                        {
                                                            <text>Không yêu cầu đơn tối thiểu</text>
                                                        }
                                                    </span>
                                                </div>
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-light voucher-apply-btn"
                                                        data-code="@promo.PromotionCode"
                                                        title="Áp dụng mã @promo.PromotionCode">
                                                    Dùng ngay
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Số tiền giảm:</span>
                            <span class="text-success" id="promoDiscountDisplay">@vnd(appliedPromoDiscount)</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <strong>Thành tiền (sau giảm):</strong>
                            <strong class="text-success" id="finalTotalDisplay">@vnd(finalAfterPromo)</strong>
                        </div>
                        <!-- ====== Hết khu vực mã khuyến mãi ====== -->

                        <div class="d-grid gap-2">
                            <a href="/Cart/Checkout" class="btn btn-success btn-lg">
                                <i class="fas fa-credit-card"></i> Thanh toán
                            </a>
                            <form action="/Cart/Clear" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-danger w-100" onclick="return confirm('Bạn có chắc chắn muốn xóa toàn bộ giỏ hàng?')">
                                    <i class="fas fa-trash"></i> Xóa giỏ hàng
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-shopping-cart fa-4x text-muted mb-4"></i>
            <h4 class="text-muted">Giỏ hàng trống</h4>
            <p class="text-muted">Hãy thêm sản phẩm vào giỏ hàng để tiếp tục mua sắm</p>
            <a href="/" class="btn btn-primary btn-lg">
                <i class="fas fa-shopping-bag"></i> Mua sắm ngay
            </a>
        </div>
    }
</div>

<style>
/* Cart Page - Luxury Cinematic Gallery */
.container {
    color: var(--lux-white, #fff);
}

/* Panel giỏ hàng tối giản */
.card {
    background: var(--lux-surface, #111) !important;
    border: 1px solid var(--lux-line, rgba(255,255,255,0.12)) !important;
    border-radius: 0 !important;
    box-shadow: none !important;
}

.card-header,
.card-header.bg-light,
.card-header.bg-primary {
    background: transparent !important;
    color: var(--lux-white, #fff) !important;
    font-family: 'Montserrat', sans-serif;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    border-bottom: 1px solid var(--lux-line, rgba(255,255,255,0.12)) !important;
}

.card-body {
    color: var(--lux-white, #fff) !important;
}

.card-body h6 {
    color: var(--lux-white, #fff) !important;
    font-weight: 500;
}

/* Giá: trắng thay vì xanh neon */
.text-success,
.card-body p.text-success {
    color: var(--lux-white, #fff) !important;
}

.text-muted {
    color: var(--lux-muted, #b3b3b3) !important;
}

/* Badge ghost */
.badge {
    background: transparent !important;
    border: 1px solid var(--lux-line, rgba(255,255,255,0.12)) !important;
    color: var(--lux-muted, #b3b3b3) !important;
    border-radius: 0 !important;
    font-family: 'Montserrat', sans-serif;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
}

/* Tất cả nút -> Ghost trắng */
.btn-outline-primary,
.btn-primary,
.btn-success,
.btn-outline-secondary,
.btn-outline-danger {
    background: transparent !important;
    border: 1px solid var(--lux-white, #fff) !important;
    color: var(--lux-white, #fff) !important;
    border-radius: 0 !important;
    font-family: 'Montserrat', sans-serif;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    box-shadow: none !important;
    transition: all 0.4s ease;
}

.btn-outline-primary:hover,
.btn-primary:hover,
.btn-success:hover,
.btn-outline-secondary:hover,
.btn-outline-danger:hover {
    background: var(--lux-white, #fff) !important;
    color: #000 !important;
    transform: none;
    box-shadow: none !important;
}

/* Nút +/- nhỏ giữ nhẹ nhàng */
.btn-sm.btn-outline-secondary {
    letter-spacing: 0;
}

/* Cụm điều chỉnh số lượng - gọn, không tràn ra ngoài cột */
.cart-qty-controls {
    max-width: 100%;
}

.cart-qty-btn {
    flex: 0 0 auto;
    width: 30px;
    padding: 0.15rem 0;
    line-height: 1;
}

.cart-qty-input {
    flex: 0 1 48px;
    width: 48px;
    min-width: 40px;
}

.cart-remove-btn {
    padding: 0.25rem 0.45rem;
}

/* Chặn nội dung tràn ngang khỏi panel danh sách sản phẩm */
.cart-item-row {
    overflow: hidden;
}

.border-bottom {
    border-bottom: 1px solid var(--lux-line-soft, rgba(255,255,255,0.06)) !important;
}

hr {
    border-color: var(--lux-line, rgba(255,255,255,0.12)) !important;
}

.form-control,
.form-select {
    background: transparent !important;
    border: 1px solid var(--lux-line, rgba(255,255,255,0.12)) !important;
    color: var(--lux-white, #fff) !important;
    border-radius: 0 !important;
}

.form-control:focus,
.form-select:focus {
    background: transparent !important;
    border-color: var(--lux-white, #fff) !important;
    box-shadow: none !important;
    color: var(--lux-white, #fff) !important;
}

.form-label {
    color: var(--lux-muted, #b3b3b3) !important;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.78rem;
}

.alert-success,
.alert-danger {
    background: var(--lux-surface, #111) !important;
    border: 1px solid var(--lux-line, rgba(255,255,255,0.12)) !important;
    color: var(--lux-white, #fff) !important;
    border-radius: 0 !important;
}

.alert-success { border-left: 2px solid var(--lux-white, #fff) !important; }
.alert-danger { border-left: 2px solid var(--lux-muted, #b3b3b3) !important; }

/* Empty cart - tối giản */
.text-center.py-5 {
    background: transparent;
    border: 1px solid var(--lux-line, rgba(255,255,255,0.12));
    border-radius: 0;
    box-shadow: none;
    padding: 4rem 2rem !important;
}

.text-center.py-5 i {
    color: var(--lux-muted, #b3b3b3) !important;
}

.text-center.py-5 h4 {
    color: var(--lux-white, #fff) !important;
}

.text-center.py-5 p {
    color: var(--lux-muted, #b3b3b3) !important;
}

/* ====== Danh sách mã khuyến mãi (Voucher Tickets) ====== */
.available-vouchers__title {
    font-family: 'Montserrat', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--lux-muted, #b3b3b3);
    margin-bottom: 0.6rem;
}

.available-vouchers__title i {
    margin-right: 6px;
    color: var(--lux-muted, #b3b3b3);
}

/* Vùng chứa voucher: giới hạn chiều cao + cuộn dọc để không kéo dài layout */
.voucher-scroll {
    max-height: 250px;
    overflow-y: auto;
    padding-right: 4px;
    /* Firefox thin scrollbar */
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,0.25) transparent;
}

/* Custom scrollbar (WebKit) - mỏng & tối màu */
.voucher-scroll::-webkit-scrollbar { width: 6px; }
.voucher-scroll::-webkit-scrollbar-track { background: transparent; }
.voucher-scroll::-webkit-scrollbar-thumb {
    background: rgba(255,255,255,0.18);
    border-radius: 0;
}
.voucher-scroll::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.32); }

/* Thẻ Voucher */
.voucher-ticket {
    background: #111;
    border: 1px dashed rgba(255,255,255,0.2);
    padding: 10px;
    margin-bottom: 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
}

.voucher-ticket:last-child { margin-bottom: 0; }

.voucher-ticket__info {
    min-width: 0;          /* cho phép text co lại trong flex, tránh tràn */
    display: flex;
    flex-direction: column;
}

.voucher-ticket__code {
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #4ade80;        /* xanh neon nổi bật trên nền tối */
    text-transform: uppercase;
    word-break: break-all;
    line-height: 1.2;
}

.voucher-ticket__cond {
    font-size: 0.72rem;
    color: var(--lux-muted, #b3b3b3);
    margin-top: 2px;
}

/* Nút "Dùng ngay" - ghost nhỏ gọn, không bị letter-spacing kéo rộng */
.voucher-apply-btn.btn-sm {
    flex: 0 0 auto;
    background: transparent !important;
    border: 1px solid var(--lux-line, rgba(255,255,255,0.4)) !important;
    color: var(--lux-white, #fff) !important;
    border-radius: 0 !important;
    font-family: 'Montserrat', sans-serif;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.68rem;
    padding: 0.3rem 0.6rem;
    white-space: nowrap;
    transition: all 0.3s ease;
}

.voucher-apply-btn.btn-sm:hover {
    background: var(--lux-white, #fff) !important;
    color: #000 !important;
    border-color: var(--lux-white, #fff) !important;
}

/* Responsive */
@@media (max-width: 768px) {
    .d-flex.align-items-center {
        flex-direction: column;
        gap: 1rem;
    }
}
</style>

<script>
function changeQuantity(productId, newQuantity) {
    if (newQuantity < 1) return;
    
    var form = document.createElement('form');
    form.method = 'POST';
    form.action = '/Cart/Update';
    
    var productIdInput = document.createElement('input');
    productIdInput.type = 'hidden';
    productIdInput.name = 'productId';
    productIdInput.value = productId;
    
    var quantityInput = document.createElement('input');
    quantityInput.type = 'hidden';
    quantityInput.name = 'quantity';
    quantityInput.value = newQuantity;
    
    form.appendChild(productIdInput);
    form.appendChild(quantityInput);
    document.body.appendChild(form);
    form.submit();
}
</script>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        (function () {
            const applyBtn = document.getElementById('applyPromoBtn');
            const promoInput = document.getElementById('promoCodeInput');
            if (!applyBtn || !promoInput) return;

            function notify(type, message) {
                if (window.Swal) {
                    Swal.fire({
                        icon: type,
                        text: message,
                        confirmButtonText: 'OK',
                        confirmButtonColor: '#198754'
                    });
                } else {
                    alert(message);
                }
            }

            function setMessage(message, ok) {
                const el = document.getElementById('promoMessage');
                if (!el) return;
                el.textContent = message || '';
                el.classList.remove('text-success', 'text-danger', 'text-muted');
                el.classList.add(message ? (ok ? 'text-success' : 'text-danger') : 'text-muted');
            }

            async function applyPromo() {
                const code = (promoInput.value || '').trim();
                if (!code) {
                    notify('warning', 'Vui lòng nhập mã khuyến mãi.');
                    return;
                }

                applyBtn.disabled = true;
                const originalHtml = applyBtn.innerHTML;
                applyBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang áp dụng...';

                try {
                    const response = await fetch('/Cart/ApplyPromotion', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ promoCode: code })
                    });

                    const data = await response.json();

                    if (data.success) {
                        // Cập nhật giao diện mượt mà, không reload trang.
                        document.getElementById('promoDiscountDisplay').textContent = data.discountValueText;
                        document.getElementById('finalTotalDisplay').textContent = data.finalTotalText;
                        setMessage(data.message, true);
                        notify('success', data.message);
                    } else {
                        // Áp mã lỗi -> reset hiển thị về 0.
                        document.getElementById('promoDiscountDisplay').textContent = '0đ';
                        setMessage(data.message, false);
                        notify('error', data.message);
                    }
                } catch (err) {
                    setMessage('Có lỗi xảy ra, vui lòng thử lại.', false);
                    notify('error', 'Có lỗi xảy ra, vui lòng thử lại.');
                } finally {
                    applyBtn.disabled = false;
                    applyBtn.innerHTML = originalHtml;
                }
            }

            applyBtn.addEventListener('click', applyPromo);
            promoInput.addEventListener('keypress', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    applyPromo();
                }
            });

            // Bấm "Dùng ngay" trên thẻ Voucher: điền mã vào ô nhập rồi kích hoạt nút Áp dụng gốc
            // (tái sử dụng toàn bộ logic AJAX + Oracle Procedure hiện có).
            document.querySelectorAll('.voucher-apply-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    const code = (this.getAttribute('data-code') || '').trim();
                    if (!code) return;
                    promoInput.value = code;
                    applyBtn.click();
                    // Cuộn ô nhập vào tầm nhìn để khách thấy mã vừa được điền.
                    promoInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
                });
            });
        })();
    </script>
}
