@model ToyStore.Models.CheckoutPageViewModel

@{
    ViewData["Title"] = "Thanh toán";
    var cart = ViewBag.Cart as ToyStore.Models.ShoppingCart ?? new ToyStore.Models.ShoppingCart();
}

<div class="container">
    <div class="row">
        <div class="col-md-8">
            <div class="card checkout-main-card">
                <div class="card-header checkout-main-header">
                    <h4 class="mb-0"><i class="fas fa-credit-card me-2"></i> Thông tin thanh toán</h4>
                </div>
                <div class="card-body">
                    <form asp-controller="Order" asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        @if (Model.IsLoggedIn && Model.Customer != null)
                        {
                            <div class="alert checkout-info-alert mb-4">
                                <h6 class="checkout-info-title">
                                    <i class="fas fa-user-check me-2"></i> Thông tin giao hàng (tài khoản)
                                </h6>
                                <p class="checkout-info-text mb-1"><strong>@Model.Customer.FullName</strong></p>
                                <p class="checkout-info-text mb-1">@Model.Customer.Email</p>
                                <p class="checkout-info-text mb-1">@(Model.Customer.Phone ?? "—")</p>
                                <p class="checkout-info-text mb-0">@(Model.Customer.Address ?? "—")</p>
                            </div>
                        }
                        else
                        {
                            <div class="alert checkout-info-alert mb-3">
                                <h6 class="checkout-info-title">
                                    <i class="fas fa-user-clock me-2"></i> Mua hàng không cần đăng ký
                                </h6>
                                <p class="checkout-info-text mb-0">
                                    Nhập thông tin bên dưới để giao hàng. Đã có tài khoản?
                                    <a asp-controller="Auth" asp-action="Login" class="alert-link">Đăng nhập</a>
                                </p>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label checkout-form-label" for="guestFullName">Họ và tên *</label>
                                    <input type="text" class="form-control checkout-form-input" id="guestFullName"
                                           name="guestFullName" value="@Model.Guest.FullName" required maxlength="100" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label checkout-form-label" for="guestEmail">Email *</label>
                                    <input type="email" class="form-control checkout-form-input" id="guestEmail"
                                           name="guestEmail" value="@Model.Guest.Email" required maxlength="100" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label checkout-form-label" for="guestPhone">Số điện thoại *</label>
                                    <input type="tel" class="form-control checkout-form-input" id="guestPhone"
                                           name="guestPhone" value="@Model.Guest.Phone" required maxlength="20" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label checkout-form-label" for="guestAddress">Địa chỉ giao hàng *</label>
                                    <input type="text" class="form-control checkout-form-input" id="guestAddress"
                                           name="guestAddress" value="@Model.Guest.Address" required maxlength="255" />
                                </div>
                            </div>
                        }

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-4">
                                    <label class="form-label checkout-form-label" for="paymentMethod">
                                        <i class="fas fa-credit-card me-2"></i>Phương thức thanh toán
                                    </label>
                                    <select name="paymentMethod" id="paymentMethod" class="form-select checkout-form-select">
                                        <option value="COD" selected>Thanh toán khi nhận hàng (COD)</option>
                                        <option value="BankTransfer">Chuyển khoản ngân hàng</option>
                                        <option value="VNPAY">Thanh toán VNPAY (Thẻ/QR)</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between checkout-actions">
                            <a href="/Cart" class="btn checkout-btn-back">
                                <i class="fas fa-arrow-left me-2"></i> Quay lại giỏ hàng
                            </a>
                            <button type="submit" class="btn checkout-btn-confirm btn-lg">
                                <i class="fas fa-check me-2"></i> Đặt hàng ngay
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card checkout-summary-card">
                <div class="card-header checkout-summary-header">
                    <h5 class="mb-0"><i class="fas fa-shopping-bag me-2"></i>Đơn hàng của bạn</h5>
                </div>
                <div class="card-body">
                    @foreach (var item in cart.Items)
                    {
                        <div class="d-flex align-items-center mb-3 checkout-item-row">
                            <div class="me-3">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.ProductName" class="checkout-product-image">
                                }
                                else
                                {
                                    <div class="checkout-image-placeholder">
                                        <i class="fas fa-image"></i>
                                    </div>
                                }
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="mb-1 checkout-product-name">@item.ProductName</h6>
                                <small class="checkout-product-quantity">Số lượng: @item.Quantity</small>
                            </div>
                            <div class="text-end">
                                <strong class="checkout-product-price">@item.Total.ToString("N0") ₫</strong>
                            </div>
                        </div>
                    }

                    <hr class="checkout-divider">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="checkout-summary-label">Tạm tính:</span>
                        <span class="checkout-summary-value">@cart.Subtotal.ToString("N0") ₫</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="checkout-summary-label">Khuyến mãi:</span>
                        <span class="checkout-summary-value">-@cart.DiscountValue.ToString("N0") ₫</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="checkout-summary-label">Phí vận chuyển:</span>
                        <span class="checkout-shipping-free">Miễn phí</span>
                    </div>
                    <hr class="checkout-divider">
                    <div class="d-flex justify-content-between">
                        <strong class="checkout-total-label">Tổng cộng:</strong>
                        <strong class="checkout-total-value">@cart.Total.ToString("N0") ₫</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* ===== Checkout - Luxury Cinematic Gallery ===== */
    .checkout-main-card,
    .checkout-summary-card {
        background: var(--lux-surface, #111) !important;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.12)) !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        color: var(--lux-white, #fff) !important;
    }

    .checkout-main-header,
    .checkout-summary-header {
        background: transparent !important;
        color: var(--lux-white, #fff) !important;
        font-family: 'Montserrat', sans-serif;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        border-bottom: 1px solid var(--lux-line, rgba(255,255,255,0.12)) !important;
    }

    .checkout-form-label {
        color: var(--lux-muted, #b3b3b3) !important;
        font-family: 'Montserrat', sans-serif;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-size: 0.78rem;
    }

    .checkout-form-select,
    .checkout-form-input {
        background: transparent !important;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.12)) !important;
        color: var(--lux-white, #fff) !important;
        border-radius: 0 !important;
        padding: 0.75rem;
    }

    .checkout-form-select:focus,
    .checkout-form-input:focus {
        background: transparent !important;
        border-color: var(--lux-white, #fff) !important;
        box-shadow: none !important;
        color: var(--lux-white, #fff) !important;
    }

    .checkout-info-alert {
        background: transparent !important;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.12)) !important;
        border-left: 2px solid var(--lux-white, #fff) !important;
        color: var(--lux-white, #fff) !important;
        border-radius: 0;
        padding: 1rem;
    }

    .checkout-info-title { color: var(--lux-white, #fff) !important; font-weight: 500; text-transform: uppercase; letter-spacing: 0.08em; }
    .checkout-info-text { color: var(--lux-muted, #b3b3b3) !important; }
    .checkout-info-alert .alert-link { color: var(--lux-white, #fff) !important; text-decoration: underline; }

    /* Nút -> Ghost */
    .checkout-btn-back,
    .checkout-btn-confirm {
        background: transparent !important;
        border: 1px solid var(--lux-white, #fff) !important;
        color: var(--lux-white, #fff) !important;
        font-family: 'Montserrat', sans-serif;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        border-radius: 0;
        padding: 0.85rem 2rem;
        transition: all 0.4s ease;
    }

    .checkout-btn-back {
        border-color: var(--lux-line, rgba(255,255,255,0.25)) !important;
        color: var(--lux-muted, #b3b3b3) !important;
    }

    /* Nút xác nhận: nền đặc trắng để nhấn mạnh hành động chính */
    .checkout-btn-confirm {
        background: var(--lux-white, #fff) !important;
        color: #000 !important;
    }

    .checkout-btn-back:hover {
        background: var(--lux-white, #fff) !important;
        color: #000 !important;
        border-color: var(--lux-white, #fff) !important;
    }

    .checkout-btn-confirm:hover {
        background: transparent !important;
        color: var(--lux-white, #fff) !important;
    }

    .checkout-product-name { color: var(--lux-white, #fff) !important; font-weight: 500; }
    .checkout-product-quantity { color: var(--lux-muted, #b3b3b3) !important; }
    .checkout-product-price { color: var(--lux-white, #fff) !important; }
    .checkout-summary-label { color: var(--lux-muted, #b3b3b3) !important; }
    .checkout-summary-value { color: var(--lux-white, #fff) !important; }
    .checkout-shipping-free { color: var(--lux-white, #fff) !important; }
    .checkout-total-label { color: var(--lux-white, #fff) !important; }
    .checkout-total-value { color: var(--lux-white, #fff) !important; font-size: 1.3rem; }
    .checkout-divider { border-color: var(--lux-line, rgba(255,255,255,0.12)) !important; }

    .checkout-product-image {
        width: 60px; height: 60px; object-fit: cover;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.12)); border-radius: 4px;
    }

    .checkout-image-placeholder {
        width: 60px; height: 60px;
        background: var(--lux-bg, #0a0a0a);
        border: 1px solid var(--lux-line, rgba(255,255,255,0.12)); border-radius: 4px;
        display: flex; align-items: center; justify-content: center;
        color: var(--lux-muted, #b3b3b3);
    }
</style>
