@{
    var section = ViewData["AdminLayoutSection"] as string ?? "Footer";
}

@if (section == "Navbar")
{
    <li class="nav-item admin-notify-nav">
        <button type="button"
                class="nav-link admin-notify-bell"
                id="adminNotifyBell"
                aria-label="Thông báo"
                title="Thông báo">
            <i class="fas fa-bell"></i>
            <span class="admin-notify-badge" id="adminNotifyBadge" hidden>0</span>
        </button>
    </li>
}

@if (section == "Footer")
{
    <div class="toast-container position-fixed bottom-0 end-0 p-3 admin-toast-container" id="adminToastContainer"></div>

    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@8.0.7/dist/browser/signalr.min.js"></script>
    <script>
        (function () {
            if (typeof signalR === 'undefined') return;

            const bell = document.getElementById('adminNotifyBell');
            const badge = document.getElementById('adminNotifyBadge');
            const toastContainer = document.getElementById('adminToastContainer');
            if (!bell || !badge || !toastContainer) return;

            let unreadCount = 0;
            let toastSeq = 0;
            const notifyAudio = new Audio('/sounds/notification.mp3');
            notifyAudio.preload = 'auto';

            function playNotifySound() {
                try {
                    notifyAudio.currentTime = 0;
                    const playPromise = notifyAudio.play();
                    if (playPromise && typeof playPromise.catch === 'function') {
                        playPromise.catch(function () { /* trình duyệt chặn autoplay */ });
                    }
                } catch (e) { /* ignore */ }
            }

            function updateBadge() {
                if (unreadCount <= 0) {
                    badge.hidden = true;
                    badge.textContent = '0';
                    return;
                }
                badge.hidden = false;
                badge.textContent = unreadCount > 99 ? '99+' : String(unreadCount);
            }

            function escapeHtml(text) {
                const div = document.createElement('div');
                div.textContent = text || '';
                return div.innerHTML;
            }

            function showAdminToast(title, message, link) {
                const toastId = 'adminToast_' + (++toastSeq);
                const safeTitle = escapeHtml(title);
                const safeMessage = escapeHtml(message);
                const safeLink = (link && link.startsWith('/')) ? link : '/';

                const toastEl = document.createElement('div');
                toastEl.className = 'toast admin-toast';
                toastEl.id = toastId;
                toastEl.setAttribute('role', 'alert');
                toastEl.setAttribute('aria-live', 'assertive');
                toastEl.setAttribute('aria-atomic', 'true');
                toastEl.innerHTML =
                    '<div class="toast-header admin-toast__header">' +
                    '<i class="fas fa-bell me-2 admin-toast__icon"></i>' +
                    '<strong class="me-auto admin-toast__title">' + safeTitle + '</strong>' +
                    '<small class="admin-toast__time">Vừa xong</small>' +
                    '<button type="button" class="btn-close btn-close-white ms-2" data-bs-dismiss="toast" aria-label="Đóng"></button>' +
                    '</div>' +
                    '<div class="toast-body admin-toast__body">' +
                    '<a href="' + safeLink + '" class="admin-toast__link">' + safeMessage + '</a>' +
                    '</div>';

                toastContainer.appendChild(toastEl);

                const bsToast = bootstrap.Toast.getOrCreateInstance(toastEl, {
                    autohide: true,
                    delay: 8000
                });

                toastEl.addEventListener('hidden.bs.toast', function () {
                    toastEl.remove();
                });

                bsToast.show();
            }

            function handleNotification(title, message, link) {
                unreadCount += 1;
                updateBadge();
                showAdminToast(title, message, link);
                playNotifySound();
            }

            bell.addEventListener('click', function () {
                unreadCount = 0;
                updateBadge();
            });

            const adminConnection = new signalR.HubConnectionBuilder()
                .withUrl('/supporthub')
                .withAutomaticReconnect()
                .build();

            adminConnection.on('ReceiveAdminNotification', function (title, message, link) {
                handleNotification(title, message, link);
            });

            adminConnection.start()
                .then(function () { return adminConnection.invoke('JoinAdminGroup'); })
                .catch(function (err) {
                    console.warn('Admin notification hub failed:', err);
                });
        })();
    </script>
}
