<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ToyStore</title>

    <!-- Google Fonts: Montserrat (tiêu đề sang trọng) + Inter (văn bản) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/layout.css?v=2" />
    <link rel="stylesheet" href="~/ToyStore.styles.css" asp-append-version="true" />
    <!-- site.css nạp SAU cùng để theme Mecha HUD ghi đè Bootstrap + layout.css -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

    <!-- Bootstrap Icons - THÊM MỚI -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.1/font/bootstrap-icons.min.css" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark custom-navbar">
            <div class="container-fluid">
                <a class="navbar-brand brand-logo" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-cube"></i> ToyStore
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="fas fa-home"></i> Trang chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Shop">
                                <i class="fas fa-store"></i> Cửa hàng
                            </a>
                        </li>
                        @if (Context.Session.GetString("IsAuthenticated") == "True")
                        {
                            @if (Context.Session.GetString("UserType") == "Admin" || Context.Session.GetString("UserType") == "Staff")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Pos" asp-action="Index">
                                        <i class="fas fa-cash-register"></i> POS
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Products" asp-action="Index">
                                        <i class="fas fa-box"></i> Sản phẩm
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Categories" asp-action="Index">
                                        <i class="fas fa-list"></i> Danh mục
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Orders" asp-action="Index">
                                        <i class="fas fa-clipboard-list"></i> Đơn hàng
                                    </a>
                                </li>
                            }
                            @if (Context.Session.GetString("UserType") == "Admin")
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-cog"></i> Quản lý
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-dark">
                                        <li><a class="dropdown-item" asp-controller="Customers" asp-action="Index"><i class="fas fa-users"></i> Khách hàng</a></li>
                                        <li><a class="dropdown-item" asp-controller="ActivityLog" asp-action="Index"><i class="fas fa-history"></i> Lịch sử hành vi</a></li>
                                        <li><a class="dropdown-item" asp-controller="Staff" asp-action="Index"><i class="fas fa-user-tie"></i> Nhân viên</a></li>
                                        <li><a class="dropdown-item" asp-controller="WorkShift" asp-action="Index"><i class="fas fa-calendar-alt"></i> Ca làm việc</a></li>
                                        <li><a class="dropdown-item" asp-controller="Payroll" asp-action="Index"><i class="fas fa-money-check-alt"></i> Bảng lương</a></li>
                                        <li><a class="dropdown-item" asp-controller="GoodsReceipt" asp-action="Index"><i class="fas fa-warehouse"></i> Nhập kho</a></li>
                                        <li><a class="dropdown-item" asp-controller="Profit" asp-action="Index"><i class="fas fa-chart-pie"></i> Lợi nhuận gộp</a></li>
                                        <li><a class="dropdown-item" asp-controller="Pos" asp-action="Index"><i class="fas fa-cash-register"></i> Bán hàng POS</a></li>
                                        <li><a class="dropdown-item" asp-controller="Products" asp-action="Index"><i class="fas fa-box"></i> Sản phẩm</a></li>
                                        <li><a class="dropdown-item" asp-controller="Categories" asp-action="Index"><i class="fas fa-list"></i> Danh mục</a></li>
                                        <li><a class="dropdown-item" asp-controller="Orders" asp-action="Index"><i class="fas fa-clipboard-list"></i> Đơn hàng</a></li>
                                        <li><a class="dropdown-item" asp-controller="Support" asp-action="Index"><i class="fas fa-headset"></i> Trò chuyện hỗ trợ</a></li>
                                        <li><a class="dropdown-item" asp-controller="Promotions" asp-action="Index"><i class="fas fa-gift"></i> Quản lý Khuyến mãi</a></li>
                                        <li><a class="dropdown-item" asp-controller="Banners" asp-action="Index"><i class="fas fa-image"></i> Quản lý Banner</a></li>
                                        <li><a class="dropdown-item" asp-controller="Statistics" asp-action="Index"><i class="fas fa-chart-line"></i> Thống kê doanh thu</a></li>
                                        <li><a class="dropdown-item" asp-controller="Revenue" asp-action="Index"><i class="fas fa-tags"></i> Khuyến mãi &amp; Doanh thu</a></li>
                                    </ul>
                                </li>
                            }
                            else if (Context.Session.GetString("UserType") == "Staff")
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-cog"></i> Quản lý
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-dark">
                                        <li><a class="dropdown-item" asp-controller="Pos" asp-action="Index"><i class="fas fa-cash-register"></i> Bán hàng POS</a></li>
                                        <li><a class="dropdown-item" asp-controller="Products" asp-action="Index"><i class="fas fa-box"></i> Sản phẩm</a></li>
                                        <li><a class="dropdown-item" asp-controller="Categories" asp-action="Index"><i class="fas fa-list"></i> Danh mục</a></li>
                                        <li><a class="dropdown-item" asp-controller="Orders" asp-action="Index"><i class="fas fa-clipboard-list"></i> Đơn hàng</a></li>
                                        <li><a class="dropdown-item" asp-controller="Support" asp-action="Index"><i class="fas fa-headset"></i> Trò chuyện hỗ trợ</a></li>
                                    </ul>
                                </li>
                            }
                            else if (Context.Session.GetString("UserType") == "Customer")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Order" asp-action="MyOrders">
                                        <i class="fas fa-receipt"></i> Đơn hàng của tôi
                                    </a>
                                </li>
                            }
                        }
                        @if (Context.Session.GetString("UserType") != "Admin" && Context.Session.GetString("UserType") != "Staff")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Cart" asp-action="Index">
                                    <i class="fas fa-shopping-cart"></i> Giỏ hàng
                                </a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item dropdown" id="support-dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-headset"></i> Hỗ trợ
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item" href="mailto:support@toystore.com">
                                        <i class="fas fa-envelope"></i> Email: support@toystore.com
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="tel:0123456789">
                                        <i class="fas fa-phone"></i> Hotline: 0123 456 789
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Home" asp-action="Privacy">
                                        <i class="fas fa-info-circle"></i> Chính sách & Điều khoản
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Home" asp-action="Privacy">
                                        <i class="fas fa-shipping-fast"></i> Giao hàng & Thanh toán
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Home" asp-action="Privacy">
                                        <i class="fas fa-undo"></i> Đổi trả & Hoàn tiền
                                    </a>
                                </li>
                            </ul>
                        </li>
                        @if (Context.Session.GetString("UserType") == "Admin" || Context.Session.GetString("UserType") == "Staff")
                        {
                            @await Html.PartialAsync("_AdminLayout", null, new ViewDataDictionary(ViewData) { { "AdminLayoutSection", "Navbar" } })
                        }
                        @if (Context.Session.GetString("IsAuthenticated") == "True")
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle user-greeting" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-user-circle"></i> @Context.Session.GetString("FullName")
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                                    <li><span class="dropdown-item-text user-type">@Context.Session.GetString("UserType")</span></li>
                                    <li><hr class="dropdown-divider"></li>
                                    @* Huy hiệu hạng thành viên: chỉ hiển thị cho khách hàng đã đạt hạng thẻ *@
                                    @await Component.InvokeAsync("MembershipStatus")
                                    @if (Context.Session.GetString("UserType") == "Customer")
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Customers" asp-action="MyProfile">
                                                <i class="fas fa-user-edit"></i> Thông tin cá nhân
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    <li>
                                        <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline w-100">
                                            <button type="submit" class="dropdown-item w-100 text-start">
                                                <i class="fas fa-sign-out-alt"></i> Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link btn-login" asp-controller="Auth" asp-action="Login">
                                    <i class="fas fa-sign-in-alt"></i> Đăng nhập
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link btn-register" asp-controller="Auth" asp-action="Register">
                                    <i class="fas fa-user-plus"></i> Đăng ký
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="custom-footer">
        <div class="container">
            <p>&copy; 2025 - ToyStore - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a></p>
        </div>
    </footer>
    @{
        var liveChatCustomerName = Context.Session.GetString("FullName") ?? "Khách hàng";
        var hideLiveChat = Context.Session.GetString("UserType") == "Admin" || Context.Session.GetString("UserType") == "Staff";
    }
    <!-- ====== ToyStore Assistant - Floating Chat Widget ====== -->
    <div id="toystore-chat">
        <!-- Cửa sổ chat (mặc định ẩn) -->
        <div id="chat-window" class="chat-window">
            <div class="chat-header">
                <div class="chat-header-info">
                    <i class="fas fa-robot" id="chat-header-icon"></i>
                    <div>
                        <div class="chat-header-title" id="chat-header-title">ToyStore Assistant</div>
                        <div class="chat-header-status"><span class="status-dot"></span> <span id="chat-header-status-text">Đang hoạt động</span></div>
                    </div>
                </div>
                <button type="button" id="chat-close" class="chat-close" aria-label="Đóng">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div id="chat-messages" class="chat-messages">
                <div class="chat-msg chat-msg-bot">
                    <div class="chat-bubble">Xin chào! 👋 Tôi là <b>ToyStore Assistant</b>. Bạn cần tìm đồ chơi gì hay hỏi giá sản phẩm nào ạ?</div>
                </div>
            </div>

            @if (!hideLiveChat)
            {
                <div class="chat-live-support-bar">
                    <button type="button" id="btnRequestSupport" class="btn btn-request-support">
                        <i class="fas fa-headset me-1"></i> Trò chuyện với nhân viên
                    </button>
                    <button type="button" id="btnDisconnectSupport" class="btn btn-disconnect-support" hidden>
                        <i class="fas fa-phone-slash me-1"></i> Ngắt kết nối
                    </button>
                </div>
            }

            <div class="chat-input-area">
                <input type="text" id="chat-input" class="chat-input" placeholder="Nhập câu hỏi của bạn..." autocomplete="off" />
                <button type="button" id="chat-send" class="chat-send" aria-label="Gửi">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </div>
        </div>

        <!-- Nút tròn bật/tắt chat -->
        <button type="button" id="chat-toggle" class="chat-toggle" aria-label="Mở chat tư vấn">
            <i class="fas fa-comment-dots" id="chat-toggle-icon"></i>
        </button>
    </div>
    <!-- ====== End Chat Widget ====== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@8.0.7/dist/browser/signalr.min.js"></script>

    <script>
        (function () {
            const toggleBtn = document.getElementById('chat-toggle');
            const toggleIcon = document.getElementById('chat-toggle-icon');
            const closeBtn = document.getElementById('chat-close');
            const chatWindow = document.getElementById('chat-window');
            const messagesEl = document.getElementById('chat-messages');
            const inputEl = document.getElementById('chat-input');
            const sendBtn = document.getElementById('chat-send');
            const btnRequestSupport = document.getElementById('btnRequestSupport');
            const btnDisconnectSupport = document.getElementById('btnDisconnectSupport');
            const chatHeaderTitle = document.getElementById('chat-header-title');
            const chatHeaderStatusText = document.getElementById('chat-header-status-text');
            const chatHeaderIcon = document.getElementById('chat-header-icon');

            const customerName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(liveChatCustomerName));
            const LIVE_SESSION_KEY = 'toystore_live_session_id';

            let isLiveChat = false;
            let liveSessionId = parseInt(sessionStorage.getItem(LIVE_SESSION_KEY) || '0', 10) || null;
            let hubConnection = null;

            function toggleChat() {
                const isOpen = chatWindow.classList.toggle('open');
                toggleIcon.className = isOpen ? 'fas fa-times' : 'fas fa-comment-dots';
                if (isOpen) {
                    inputEl.focus();
                    scrollToBottom();
                    ensureHubConnection();
                }
            }

            toggleBtn.addEventListener('click', toggleChat);
            closeBtn.addEventListener('click', toggleChat);

            function scrollToBottom() {
                messagesEl.scrollTop = messagesEl.scrollHeight;
            }

            function appendMessage(html, sender, asText) {
                const wrap = document.createElement('div');
                wrap.className = 'chat-msg ' + (sender === 'user' ? 'chat-msg-user' : 'chat-msg-bot');

                const bubble = document.createElement('div');
                bubble.className = 'chat-bubble';
                if (asText || sender === 'user') {
                    bubble.textContent = html;
                } else {
                    bubble.innerHTML = html;
                }

                wrap.appendChild(bubble);
                messagesEl.appendChild(wrap);
                scrollToBottom();
            }

            function appendSystemMessage(text) {
                appendMessage(text, 'bot', true);
            }

            function showTyping() {
                const typing = document.createElement('div');
                typing.className = 'chat-msg chat-msg-bot';
                typing.id = 'chat-typing';
                typing.innerHTML =
                    '<div class="chat-bubble chat-typing"><span></span><span></span><span></span></div>';
                messagesEl.appendChild(typing);
                scrollToBottom();
            }

            function removeTyping() {
                const typing = document.getElementById('chat-typing');
                if (typing) typing.remove();
            }

            function setLiveChatUi(active) {
                isLiveChat = active;
                if (!chatHeaderTitle || !chatHeaderStatusText || !chatHeaderIcon) return;

                if (active) {
                    chatHeaderTitle.textContent = 'Live Chat';
                    chatHeaderStatusText.textContent = 'Đang kết nối với nhân viên...';
                    chatHeaderIcon.className = 'fas fa-headset';
                    inputEl.placeholder = 'Nhập tin nhắn gửi nhân viên...';
                    if (btnRequestSupport) btnRequestSupport.hidden = true;
                    if (btnDisconnectSupport) btnDisconnectSupport.hidden = false;
                } else {
                    chatHeaderTitle.textContent = 'ToyStore Assistant';
                    chatHeaderStatusText.textContent = 'Đang hoạt động';
                    chatHeaderIcon.className = 'fas fa-robot';
                    inputEl.placeholder = 'Nhập câu hỏi của bạn...';
                    if (btnRequestSupport) {
                        btnRequestSupport.hidden = false;
                        btnRequestSupport.disabled = false;
                    }
                    if (btnDisconnectSupport) {
                        btnDisconnectSupport.hidden = true;
                        btnDisconnectSupport.disabled = false;
                    }
                }
            }

            function clearLiveSessionState() {
                liveSessionId = null;
                sessionStorage.removeItem(LIVE_SESSION_KEY);
            }

            function exitLiveChatMode(message) {
                if (!isLiveChat && !liveSessionId) return;

                clearLiveSessionState();
                setLiveChatUi(false);

                if (message) {
                    appendSystemMessage(message);
                }
            }

            async function ensureHubConnection() {
                if (typeof signalR === 'undefined') {
                    throw new Error('Thư viện SignalR chưa được tải.');
                }

                if (hubConnection && hubConnection.state === signalR.HubConnectionState.Connected) {
                    return hubConnection;
                }

                if (!hubConnection) {
                    hubConnection = new signalR.HubConnectionBuilder()
                        .withUrl('/supporthub')
                        .withAutomaticReconnect()
                        .build();

                    hubConnection.on('ReceiveMessage', function (sessionId, sender, message) {
                        if (!isLiveChat || Number(sessionId) !== Number(liveSessionId)) return;
                        if (sender === 'Customer') return;
                        appendMessage(message, 'bot', true);
                    });

                    hubConnection.on('SessionStatusChanged', function (sessionId, status, initiator) {
                        if (Number(sessionId) !== Number(liveSessionId) && isLiveChat) return;
                        if (!chatHeaderStatusText) return;

                        if (status === 'Active') {
                            chatHeaderStatusText.textContent = 'Nhân viên đã kết nối';
                            appendSystemMessage('Nhân viên đã tham gia cuộc trò chuyện. Bạn có thể nhắn tin ngay!');
                        } else if (status === 'Closed') {
                            const byStaff = initiator === 'Staff';
                            exitLiveChatMode(
                                byStaff
                                    ? 'Nhân viên đã kết thúc phiên hỗ trợ. Bạn có thể tiếp tục chat với ToyStore Assistant.'
                                    : 'Bạn đã ngắt kết nối Live Chat. Bạn có thể tiếp tục chat với ToyStore Assistant.'
                            );
                        }
                    });
                }

                if (hubConnection.state === signalR.HubConnectionState.Disconnected) {
                    await hubConnection.start();
                }

                return hubConnection;
            }

            async function createLiveSession(conn) {
                liveSessionId = await conn.invoke('RequestSupport', customerName);
                sessionStorage.setItem(LIVE_SESSION_KEY, String(liveSessionId));
            }

            async function startLiveSupport() {
                if (btnRequestSupport) btnRequestSupport.disabled = true;

                try {
                    setLiveChatUi(true);
                    appendSystemMessage('Đang kết nối với nhân viên...');

                    const conn = await ensureHubConnection();

                    if (liveSessionId) {
                        try {
                            const checkRes = await fetch('/Chat/CheckLiveSession?sessionId=' + encodeURIComponent(liveSessionId));
                            const checkData = await checkRes.json();
                            if (checkData.exists) {
                                await conn.invoke('JoinRoom', liveSessionId);
                            } else {
                                liveSessionId = null;
                                sessionStorage.removeItem(LIVE_SESSION_KEY);
                                await createLiveSession(conn);
                            }
                        } catch {
                            liveSessionId = null;
                            sessionStorage.removeItem(LIVE_SESSION_KEY);
                            await createLiveSession(conn);
                        }
                    } else {
                        await createLiveSession(conn);
                    }

                    appendSystemMessage('Đã gửi yêu cầu hỗ trợ. Vui lòng chờ nhân viên phản hồi.');
                } catch (err) {
                    console.error('Live chat error:', err);
                    clearLiveSessionState();
                    setLiveChatUi(false);
                    const detail = (err && err.message) ? err.message : '';
                    appendSystemMessage('Không thể kết nối Live Chat. ' + (detail || 'Vui lòng thử lại sau.'));
                } finally {
                    if (btnRequestSupport && !isLiveChat) {
                        btnRequestSupport.disabled = false;
                    }
                }
            }

            async function disconnectLiveSupport() {
                if (!isLiveChat || !liveSessionId || !hubConnection) return;

                if (btnDisconnectSupport) btnDisconnectSupport.disabled = true;
                const closingSessionId = liveSessionId;

                try {
                    await hubConnection.invoke('DisconnectSupport', closingSessionId, 'Customer');
                    exitLiveChatMode('Bạn đã ngắt kết nối Live Chat. Bạn có thể tiếp tục chat với ToyStore Assistant.');
                } catch (err) {
                    console.error('Disconnect live chat error:', err);
                    appendSystemMessage('Không thể ngắt kết nối. Vui lòng thử lại.');
                    if (btnDisconnectSupport) btnDisconnectSupport.disabled = false;
                }
            }

            if (btnRequestSupport) {
                btnRequestSupport.addEventListener('click', startLiveSupport);
            }

            if (btnDisconnectSupport) {
                btnDisconnectSupport.addEventListener('click', disconnectLiveSupport);
            }

            async function sendMessage() {
                const text = inputEl.value.trim();
                if (!text) return;

                appendMessage(text, 'user', true);
                inputEl.value = '';
                inputEl.focus();

                if (isLiveChat && liveSessionId && hubConnection) {
                    try {
                        await hubConnection.invoke('SendMessage', liveSessionId, 'Customer', text);
                    } catch (err) {
                        const detail = (err && err.message) ? err.message : '';
                        if (detail.indexOf('đã đóng') >= 0 || detail.indexOf('Closed') >= 0) {
                            exitLiveChatMode('Phiên Live Chat đã kết thúc. Bạn có thể tiếp tục chat với ToyStore Assistant.');
                        } else {
                            appendSystemMessage('Gửi tin nhắn thất bại. Vui lòng thử lại.');
                        }
                    }
                    return;
                }

                showTyping();
                try {
                    const res = await fetch('/Chat/SendMessage', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ Message: text })
                    });
                    const data = await res.json();
                    removeTyping();
                    appendMessage(data.response || 'Xin lỗi, đã có lỗi xảy ra.', 'bot', false);
                } catch (err) {
                    removeTyping();
                    appendMessage('⚠️ Không thể kết nối tới máy chủ. Vui lòng thử lại sau!', 'bot', true);
                }
            }

            sendBtn.addEventListener('click', sendMessage);
            inputEl.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    sendMessage();
                }
            });

            if (liveSessionId && btnRequestSupport) {
                ensureHubConnection()
                    .then(async function () {
                        const checkRes = await fetch('/Chat/CheckLiveSession?sessionId=' + encodeURIComponent(liveSessionId));
                        const checkData = await checkRes.json();
                        if (!checkData.exists) {
                            clearLiveSessionState();
                            return;
                        }
                        return hubConnection.invoke('JoinRoom', liveSessionId);
                    })
                    .then(function () {
                        if (liveSessionId) setLiveChatUi(true);
                    })
                    .catch(function () {
                        clearLiveSessionState();
                    });
            }
        })();
    </script>

    @if (Context.Session.GetString("UserType") == "Admin" || Context.Session.GetString("UserType") == "Staff")
    {
        @await Html.PartialAsync("_AdminLayout", null, new ViewDataDictionary(ViewData) { { "AdminLayoutSection", "Footer" } })
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
