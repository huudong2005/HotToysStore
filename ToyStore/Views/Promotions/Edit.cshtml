@model ToyStore.Domain.Entities.Promotion

@{
    ViewData["Title"] = "Cập nhật khuyến mãi";
}

<div class="row justify-content-center">
    <div class="col-md-9">
        <div class="card text-white" style="background-color: #111111; border: 1px solid rgba(255,255,255,0.12); box-shadow: none; border-radius: 0;">

            <div class="card-header" style="background-color: transparent; color: #ffffff; border-bottom: 1px solid rgba(255,255,255,0.12); font-family: 'Montserrat', sans-serif; text-transform: uppercase; letter-spacing: 0.1em;">
                <h4 class="mb-0 fw-bold"><i class="fas fa-edit me-2"></i>Cập nhật khuyến mãi</h4>
            </div>

            <div class="card-body">
                <form asp-controller="Promotions" asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <input type="hidden" asp-for="PromotionId" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="PromotionCode" class="form-label"></label>
                            <input asp-for="PromotionCode" class="form-control bg-dark text-white border-secondary" />
                            <span asp-validation-for="PromotionCode" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PromotionName" class="form-label"></label>
                            <input asp-for="PromotionName" class="form-control bg-dark text-white border-secondary" />
                            <span asp-validation-for="PromotionName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="DiscountType" class="form-label"></label>
                            <select asp-for="DiscountType" class="form-select bg-dark text-white border-secondary">
                                <option value="Percentage">Giảm theo %</option>
                                <option value="FixedAmount">Giảm tiền mặt</option>
                            </select>
                            <span asp-validation-for="DiscountType" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="DiscountValue" class="form-label"></label>
                            <input asp-for="DiscountValue" type="number" step="0.01" min="0" class="form-control bg-dark text-white border-secondary" />
                            <span asp-validation-for="DiscountValue" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="MinOrderValue" class="form-label"></label>
                            <input asp-for="MinOrderValue" type="number" step="1000" min="0" class="form-control bg-dark text-white border-secondary" />
                            <span asp-validation-for="MinOrderValue" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="StartDate" class="form-label"></label>
                            <input asp-for="StartDate" type="datetime-local" class="form-control bg-dark text-white border-secondary" />
                            <span asp-validation-for="StartDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="EndDate" class="form-label"></label>
                            <input asp-for="EndDate" type="datetime-local" class="form-control bg-dark text-white border-secondary" />
                            <span asp-validation-for="EndDate" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="UsageLimit" class="form-label"></label>
                            <input asp-for="UsageLimit" type="number" min="0" class="form-control bg-dark text-white border-secondary" />
                            <span asp-validation-for="UsageLimit" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="UsedCount" class="form-label"></label>
                            <input asp-for="UsedCount" type="number" min="0" class="form-control bg-dark text-white border-secondary" />
                            <span asp-validation-for="UsedCount" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3 d-flex align-items-end">
                            <div class="form-check form-switch fs-5">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                                <label asp-for="IsActive" class="form-check-label text-light"></label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-light">
                            <i class="fas fa-arrow-left me-1"></i>Quay lại
                        </a>
                        <button type="submit" class="btn fw-bold" style="background-color: transparent; color: #ffffff; border: 1px solid #ffffff; border-radius: 0; text-transform: uppercase; letter-spacing: 0.1em; font-family: 'Montserrat', sans-serif; box-shadow: none; transition: all 0.4s ease;">
                            <i class="fas fa-save me-1"></i>Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}