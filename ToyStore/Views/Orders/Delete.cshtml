@model ToyStore.Domain.Entities.Order

@{
    ViewData["Title"] = "Xóa đơn hàng";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">Xác nhận xóa đơn hàng</h4>
            </div>
            <div class="card-body">
                <div class="alert alert-danger" role="alert">
                    <i class="fas fa-exclamation-triangle"></i>
                    <strong>Cảnh báo!</strong> Bạn có chắc chắn muốn xóa đơn hàng này không? 
                    <br /><br />
                    <strong>Lưu ý:</strong> Hệ thống sẽ xóa cả đơn hàng và tất cả chi tiết sản phẩm liên quan. Hành động này không thể hoàn tác!
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <h5 class="text-danger">Đơn hàng #@Model.OrderId</h5>
                        <p class="text-muted">@(Model.Customer?.FullName ?? "Không có thông tin khách hàng")</p>
                    </div>
                    <div class="col-md-6">
                        <div class="text-end">
                            <strong>Tổng tiền:</strong>
                            <span class="text-success fw-bold fs-5">@Model.TotalAmount.ToString("N0") ₫</span>
                        </div>
                    </div>
                </div>
                
                <dl class="row mt-3">
                    <dt class="col-sm-3">Ngày đặt:</dt>
                    <dd class="col-sm-9">@(Model.OrderDate?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</dd>
                    
                    <dt class="col-sm-3">Trạng thái:</dt>
                    <dd class="col-sm-9">
                        @{
                            string statusClass = Model.Status switch
                            {
                                "Pending" => "bg-warning",
                                "Confirmed" => "bg-success",
                                "Cancelled" => "bg-danger",
                                "Completed" => "bg-info",
                                _ => "bg-secondary"
                            };
                            string statusText = Model.Status switch
                            {
                                "Pending" => "Chờ xác nhận",
                                "Confirmed" => "Đã xác nhận",
                                "Cancelled" => "Đã hủy",
                                "Completed" => "Hoàn thành",
                                _ => Model.Status
                            };
                        }
                        <span class="badge @statusClass">@statusText</span>
                    </dd>
                    
                    <dt class="col-sm-3">Phương thức thanh toán:</dt>
                    <dd class="col-sm-9">
                        <span class="badge bg-primary">@Model.PaymentMethod</span>
                    </dd>
                    
                    @if (!string.IsNullOrEmpty(Model.DeliveryMethod))
                    {
                        <dt class="col-sm-3">Phương thức giao hàng:</dt>
                        <dd class="col-sm-9">@Model.DeliveryMethod</dd>
                    }
                </dl>

                <form asp-action="Delete" method="post" class="d-inline">
                    <input type="hidden" asp-for="OrderId" />
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash"></i> Xác nhận xóa
                    </button>
                </form>
                <a asp-action="Index" class="btn btn-secondary ms-2">
                    <i class="fas fa-arrow-left"></i> Quay lại
                </a>
            </div>
        </div>
    </div>
</div>
