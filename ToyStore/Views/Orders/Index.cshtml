@model IEnumerable<ToyStore.Domain.Entities.Order>

@{
    ViewData["Title"] = "Quản lý đơn hàng";
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
}

@functions {
    // Chuẩn hóa trạng thái: gộp nhãn tiếng Anh (legacy) và tiếng Việt về một bộ chuẩn tiếng Việt.
    static string NormalizeStatus(string? status)
    {
        var s = (status ?? string.Empty).Trim();
        return s switch
        {
            "Pending" or "Chờ xác nhận" => "Chờ xác nhận",
            "Confirmed" or "Đã xác nhận" => "Đã xác nhận",
            "Shipped" or "Shipping" or "Đang giao" or "Đang giao hàng" => "Đang giao hàng",
            "Completed" or "Hoàn thành" => "Hoàn thành",
            "Cancelled" or "Canceled" or "Đã hủy" => "Đã hủy",
            _ => s
        };
    }
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-shopping-bag"></i> Quản lý đơn hàng</h2>
        <div class="d-flex align-items-center gap-3">
            <form method="get" action="/Orders" class="d-flex align-items-center gap-2">
                <div class="search-group">
                    <input type="text" name="searchCustomer" value="@ViewBag.SearchCustomer" 
                           class="form-control search-input" 
                           placeholder="Tìm theo tên khách hàng..." />
                </div>
                <div class="search-group">
                    <input type="date" name="searchDate" value="@ViewBag.SearchDate" 
                           class="form-control date-input" 
                           placeholder="Chọn ngày..." />
                </div>
                <button type="submit" class="btn btn-outline-light">
                    <i class="fas fa-search"></i> Tìm kiếm
                </button>
                @if (!string.IsNullOrEmpty((string)ViewBag.SearchCustomer) || !string.IsNullOrEmpty((string)ViewBag.SearchDate))
                {
                    <a href="/Orders" class="btn btn-outline-secondary">
                        <i class="fas fa-times"></i> Xóa bộ lọc
                    </a>
                }
            </form>
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus"></i> Tạo đơn hàng mới
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div id="order-status-alert" class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div id="order-status-alert" class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@errorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div id="order-toast-container" class="order-toast-container" aria-live="polite" aria-atomic="true"></div>

    @if (Model.Any())
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th><i class="fas fa-hashtag me-2"></i>Mã đơn hàng</th>
                                <th><i class="fas fa-user me-2"></i>Khách hàng</th>
                                <th><i class="fas fa-calendar me-2"></i>Ngày đặt</th>
                                <th><i class="fas fa-dollar-sign me-2"></i>Tổng tiền</th>
                                <th><i class="fas fa-info-circle me-2"></i>Trạng thái</th>
                                <th><i class="fas fa-credit-card me-2"></i>Phương thức thanh toán</th>
                                <th><i class="fas fa-cogs me-2"></i>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var currentStatus = NormalizeStatus(item.Status);
                                bool isLocked = currentStatus == "Hoàn thành" || currentStatus == "Đã hủy";
                                var statusOptions = new[] { "Chờ xác nhận", "Đã xác nhận", "Đang giao hàng", "Hoàn thành", "Đã hủy" };
                                <tr data-order-id="@item.OrderId">
                                    <td>
                                        <span class="badge bg-primary fs-6">#@item.OrderId</span>
                                    </td>
                                    <td>
                                        @if (item.Customer != null)
                                        {
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-circle me-2">
                                                    <i class="fas fa-user"></i>
                                                </div>
                                                <div>
                                                    <strong>@item.Customer.FullName</strong>
                                                    <br />
                                                    <small class="text-muted">@item.Customer.Email</small>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Không có thông tin</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="text-muted">@item.OrderDate?.ToString("dd/MM/yyyy HH:mm")</span>
                                    </td>
                                    <td>
                                        <strong class="text-success">@item.TotalAmount.ToString("N0") ₫</strong>
                                    </td>
                                    <td>
                                        @{
                                            string statusClass = currentStatus switch
                                            {
                                                "Chờ xác nhận" => "bg-warning",
                                                "Đã xác nhận" => "bg-success",
                                                "Đang giao hàng" => "bg-primary",
                                                "Hoàn thành" => "bg-info",
                                                "Đã hủy" => "bg-danger",
                                                _ => "bg-secondary"
                                            };
                                            string statusIcon = currentStatus switch
                                            {
                                                "Chờ xác nhận" => "fas fa-clock",
                                                "Đã xác nhận" => "fas fa-check-circle",
                                                "Đang giao hàng" => "fas fa-truck",
                                                "Hoàn thành" => "fas fa-check-double",
                                                "Đã hủy" => "fas fa-times-circle",
                                                _ => "fas fa-question-circle"
                                            };
                                        }
                                        <span class="badge @statusClass" id="status-badge-@item.OrderId">
                                            <i class="@statusIcon me-1" id="status-icon-@item.OrderId"></i><span id="status-text-@item.OrderId">@currentStatus</span>
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary">@item.PaymentMethod</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2 order-actions">
                                            <form asp-action="UpdateStatus" method="post" class="d-flex align-items-center gap-2 mb-0 status-update-form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="orderId" value="@item.OrderId" />
                                                <select name="newStatus" class="form-select form-select-sm bg-dark text-white border-secondary status-select"
                                                        @(isLocked ? "disabled" : "")>
                                                    @foreach (var opt in statusOptions)
                                                    {
                                                        if (opt == currentStatus)
                                                        {
                                                            <option value="@opt" selected>@opt</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@opt">@opt</option>
                                                        }
                                                    }
                                                </select>
                                                <button type="submit" class="btn btn-sm btn-outline-light" title="Lưu trạng thái"
                                                        @(isLocked ? "disabled" : "")>
                                                    <i class="fas fa-save"></i>
                                                </button>
                                            </form>

                                            <a asp-action="Details" asp-route-id="@item.OrderId" class="btn btn-sm btn-outline-light" title="Xem chi tiết">
                                                <i class="fas fa-eye"></i>
                                            </a>

                                            <a asp-action="Edit" asp-route-id="@item.OrderId" class="btn btn-sm btn-outline-light" title="Chỉnh sửa">
                                                <i class="fas fa-edit"></i>
                                            </a>

                                            <a asp-action="Delete" asp-route-id="@item.OrderId" class="btn btn-sm btn-outline-light" title="Xóa">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-shopping-bag fa-4x text-muted mb-4"></i>
            <h4 class="text-muted">Chưa có đơn hàng nào</h4>
            <p class="text-muted">Chưa có đơn hàng nào trong hệ thống</p>
            <a asp-action="Create" class="btn btn-primary">Tạo đơn hàng đầu tiên</a>
        </div>
    }
</div>

<style>
    /* ===== Quản lý đơn hàng - Luxury Cinematic Gallery ===== */
    .avatar-circle {
        width: 35px;
        height: 35px;
        background: transparent;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.25));
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--lux-white, #fff);
        font-size: 0.9rem;
    }

    .table th {
        border-top: none;
        font-family: 'Montserrat', sans-serif;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        background: transparent !important;
        color: var(--lux-white, #fff) !important;
        border-bottom: 1px solid var(--lux-line, rgba(255,255,255,0.12)) !important;
    }

    .table td {
        vertical-align: middle;
        color: var(--lux-white, #fff) !important;
        border-color: var(--lux-line-soft, rgba(255,255,255,0.06)) !important;
    }

    .table-hover > tbody > tr:hover > td {
        background-color: rgba(255, 255, 255, 0.05) !important;
    }

    .btn-group .btn { margin-right: 4px; }
    .btn-group .btn:last-child { margin-right: 0; }

    /* ===== Cập nhật trạng thái đơn hàng (giữ bố cục gọn, không xô lệch cột) ===== */
    .order-actions { flex-wrap: nowrap; }

    .order-actions .status-update-form { flex-wrap: nowrap; }

    /* Select trạng thái: nền tối, viền mờ, bề rộng cố định để cột không bị giãn. */
    .status-select {
        background-color: var(--lux-bg, #0a0a0a) !important;
        color: var(--lux-white, #fff) !important;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.25)) !important;
        border-radius: 0 !important;
        min-width: 150px;
        width: auto;
        font-family: 'Montserrat', sans-serif;
        letter-spacing: 0.04em;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23ffffff' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M2 5l6 6 6-6'/%3e%3c/svg%3e") !important;
        background-repeat: no-repeat !important;
        background-position: right 0.6rem center !important;
        background-size: 14px 11px !important;
    }

    .status-select:focus {
        background-color: var(--lux-bg, #0a0a0a) !important;
        border-color: var(--lux-white, #fff) !important;
        box-shadow: none !important;
        color: var(--lux-white, #fff) !important;
    }

    /* Sửa lỗi chữ trắng trên nền trắng khi xổ danh sách option. */
    .status-select option {
        background-color: var(--lux-surface, #111) !important;
        color: var(--lux-white, #fff) !important;
    }

    .status-select:disabled {
        opacity: 0.55;
        cursor: not-allowed;
    }

    /* Nút trong khu thao tác: gọn, không bị margin của btn-group cũ kéo lệch. */
    .order-actions .btn { margin: 0; padding: 0.35rem 0.6rem; }

    .card {
        background: var(--lux-surface, #111) !important;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.12)) !important;
        border-radius: 0 !important;
        box-shadow: none !important;
    }

    .card-body { color: var(--lux-white, #fff) !important; }

    .alert-success,
    .alert-danger {
        background: var(--lux-surface, #111) !important;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.12)) !important;
        color: var(--lux-white, #fff) !important;
        border-radius: 0 !important;
    }
    .alert-success { border-left: 2px solid var(--lux-white, #fff) !important; }
    .alert-danger { border-left: 2px solid var(--lux-muted, #b3b3b3) !important; }

    /* Mọi nút -> Ghost trắng */
    .btn-primary,
    .btn-info,
    .btn-warning,
    .btn-danger,
    .btn-success,
    .btn-outline-light,
    .btn-outline-secondary {
        background: transparent !important;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.25)) !important;
        color: var(--lux-white, #fff) !important;
        border-radius: 0 !important;
        font-family: 'Montserrat', sans-serif;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        box-shadow: none !important;
        transition: all 0.4s ease;
    }

    .btn-primary:hover,
    .btn-info:hover,
    .btn-warning:hover,
    .btn-danger:hover,
    .btn-success:hover,
    .btn-outline-light:hover,
    .btn-outline-secondary:hover {
        background: var(--lux-white, #fff) !important;
        color: #000 !important;
        border-color: var(--lux-white, #fff) !important;
        transform: none;
        box-shadow: none !important;
    }

    .text-success { color: var(--lux-white, #fff) !important; }
    .text-muted { color: var(--lux-muted, #b3b3b3) !important; }

    /* Badge ghost */
    .badge,
    .badge.bg-primary,
    .badge.bg-secondary,
    .badge.bg-success,
    .badge.bg-warning,
    .badge.bg-danger,
    .badge.bg-info {
        background: transparent !important;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.3)) !important;
        color: var(--lux-muted, #b3b3b3) !important;
        border-radius: 0 !important;
        font-family: 'Montserrat', sans-serif;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .text-center.py-5 {
        background: transparent;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.12));
        border-radius: 0;
        box-shadow: none;
        padding: 4rem 2rem !important;
    }

    .text-center.py-5 i { color: var(--lux-muted, #b3b3b3) !important; }
    .text-center.py-5 h4 { color: var(--lux-white, #fff) !important; }
    .text-center.py-5 p { color: var(--lux-muted, #b3b3b3) !important; }

    .search-group { position: relative; }

    .search-input,
    .date-input {
        background: transparent !important;
        border: 1px solid var(--lux-line, rgba(255,255,255,0.12)) !important;
        border-radius: 0 !important;
        color: var(--lux-white, #fff) !important;
        padding: 0.5rem 1rem;
        min-width: 200px;
    }

    .search-input::placeholder { color: var(--lux-faint, #808080) !important; }

    .search-input:focus,
    .date-input:focus {
        background: transparent !important;
        border-color: var(--lux-white, #fff) !important;
        box-shadow: none !important;
        outline: none;
    }

    .date-input { cursor: pointer; color-scheme: dark; }

    .gap-2 { gap: 0.5rem !important; }
    .gap-3 { gap: 1rem !important; }

    /* Toast thông báo cố định góc phải màn hình */
    .order-toast-container {
        position: fixed;
        top: 5.5rem;
        right: 1.25rem;
        z-index: 1080;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        max-width: min(420px, calc(100vw - 2rem));
        pointer-events: none;
    }

    .order-toast {
        pointer-events: auto;
        background: var(--lux-surface, #111);
        border: 1px solid var(--lux-line, rgba(255,255,255,0.25));
        color: var(--lux-white, #fff);
        padding: 0.9rem 1.1rem;
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        animation: orderToastIn 0.35s ease;
    }

    .order-toast--success { border-left: 3px solid #4ade80; }
    .order-toast--error { border-left: 3px solid #f87171; }

    .order-toast__icon {
        font-size: 1.1rem;
        margin-top: 0.1rem;
        flex-shrink: 0;
    }

    .order-toast--success .order-toast__icon { color: #4ade80; }
    .order-toast--error .order-toast__icon { color: #f87171; }

    .order-toast__message {
        flex: 1;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.92rem;
        line-height: 1.45;
    }

    .order-toast__close {
        background: transparent;
        border: none;
        color: var(--lux-muted, #b3b3b3);
        cursor: pointer;
        padding: 0;
        line-height: 1;
    }

    .order-toast__close:hover { color: var(--lux-white, #fff); }

    .order-toast.is-hiding {
        animation: orderToastOut 0.35s ease forwards;
    }

    @@keyframes orderToastIn {
        from { opacity: 0; transform: translateX(24px); }
        to { opacity: 1; transform: translateX(0); }
    }

    @@keyframes orderToastOut {
        from { opacity: 1; transform: translateX(0); }
        to { opacity: 0; transform: translateX(24px); }
    }

    @@media (max-width: 768px) {
        .d-flex.justify-content-between {
            flex-direction: column;
            align-items: flex-start !important;
        }
        .search-group .search-input,
        .search-group .date-input { min-width: 150px; }
        .d-flex.align-items-center { flex-wrap: wrap; }
    }
</style>

@section Scripts {
    <script>
        (function () {
            const statusMeta = {
                'Chờ xác nhận': { className: 'bg-warning', icon: 'fas fa-clock' },
                'Đã xác nhận': { className: 'bg-success', icon: 'fas fa-check-circle' },
                'Đang giao hàng': { className: 'bg-primary', icon: 'fas fa-truck' },
                'Hoàn thành': { className: 'bg-info', icon: 'fas fa-check-double' },
                'Đã hủy': { className: 'bg-danger', icon: 'fas fa-times-circle' }
            };

            const lockedStatuses = ['Hoàn thành', 'Đã hủy'];
            const toastContainer = document.getElementById('order-toast-container');

            function showOrderToast(message, type) {
                if (!toastContainer || !message) return;

                const toast = document.createElement('div');
                toast.className = 'order-toast order-toast--' + (type === 'success' ? 'success' : 'error');
                toast.innerHTML =
                    '<i class="order-toast__icon ' + (type === 'success' ? 'fas fa-check-circle' : 'fas fa-exclamation-triangle') + '"></i>' +
                    '<div class="order-toast__message"></div>' +
                    '<button type="button" class="order-toast__close" aria-label="Đóng"><i class="fas fa-times"></i></button>';
                toast.querySelector('.order-toast__message').textContent = message;

                const closeBtn = toast.querySelector('.order-toast__close');
                const removeToast = function () {
                    toast.classList.add('is-hiding');
                    setTimeout(function () { toast.remove(); }, 350);
                };

                closeBtn.addEventListener('click', removeToast);
                toastContainer.appendChild(toast);
                setTimeout(removeToast, 4500);
            }

            function updateStatusBadge(orderId, status) {
                const badge = document.getElementById('status-badge-' + orderId);
                const icon = document.getElementById('status-icon-' + orderId);
                const text = document.getElementById('status-text-' + orderId);
                const meta = statusMeta[status];
                if (!badge || !icon || !text || !meta) return;

                badge.className = 'badge ' + meta.className;
                icon.className = meta.icon + ' me-1';
                text.textContent = status;
            }

            function setFormLocked(form, locked) {
                const select = form.querySelector('.status-select');
                const button = form.querySelector('button[type="submit"]');
                if (select) select.disabled = locked;
                if (button) button.disabled = locked;
            }

            document.querySelectorAll('.status-update-form').forEach(function (form) {
                form.addEventListener('submit', async function (e) {
                    e.preventDefault();

                    const orderId = form.querySelector('input[name="orderId"]')?.value;
                    const newStatus = form.querySelector('select[name="newStatus"]')?.value;
                    const token = form.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    const submitBtn = form.querySelector('button[type="submit"]');

                    if (!orderId || !newStatus || !token) return;

                    const originalHtml = submitBtn ? submitBtn.innerHTML : '';
                    if (submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
                    }

                    try {
                        const body = new URLSearchParams();
                        body.append('orderId', orderId);
                        body.append('newStatus', newStatus);
                        body.append('__RequestVerificationToken', token);

                        const response = await fetch('/Orders/UpdateStatus', {
                            method: 'POST',
                            headers: {
                                'Accept': 'application/json',
                                'Content-Type': 'application/x-www-form-urlencoded'
                            },
                            body: body.toString()
                        });

                        const data = await response.json();

                        if (data.success) {
                            if (data.newStatus) {
                                updateStatusBadge(orderId, data.newStatus);
                                if (lockedStatuses.includes(data.newStatus)) {
                                    setFormLocked(form, true);
                                }
                            }
                            showOrderToast(data.message, 'success');
                        } else {
                            showOrderToast(data.message || 'Không thể cập nhật trạng thái đơn hàng.', 'error');
                        }
                    } catch (err) {
                        showOrderToast('Có lỗi xảy ra, vui lòng thử lại.', 'error');
                    } finally {
                        if (submitBtn) {
                            submitBtn.disabled = form.querySelector('.status-select')?.disabled ?? false;
                            submitBtn.innerHTML = originalHtml;
                        }
                    }
                });
            });

            @if (!string.IsNullOrEmpty(successMessage))
            {
                @:showOrderToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(successMessage)), 'success');
            }
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                @:showOrderToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(errorMessage)), 'error');
            }

            const alertBox = document.getElementById('order-status-alert');
            if (alertBox) {
                alertBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
        })();
    </script>
}
