@model ToyStore.Models.VnPayPaymentResultViewModel

@{
    ViewData["Title"] = Model.IsSuccess ? "Thanh toán thành công" : "Thanh toán thất bại";
}

<div class="crud-theme container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header @(Model.IsSuccess ? "bg-success" : "bg-danger") text-white">
                    <h4 class="mb-0 text-dark">
                        <i class="fas @(Model.IsSuccess ? "fa-check-circle" : "fa-times-circle") me-2"></i>
                        @(Model.IsSuccess ? "Thanh toán VNPAY thành công" : "Thanh toán VNPAY thất bại")
                    </h4>
                </div>
                <div class="card-body">
                    <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-warning") mb-4" role="alert">
                        <i class="fas @(Model.IsSuccess ? "fa-circle-check" : "fa-circle-exclamation") me-2"></i>
                        @Model.Message
                    </div>

                    @if (Model.IsSuccess)
                    {
                        <div class="payment-summary rounded p-3 mb-4">
                            <h5 class="payment-summary__title mb-3">
                                <i class="fas fa-receipt me-2"></i>Thông tin giao dịch
                            </h5>
                            <dl class="row mb-0 payment-summary__list">
                                <dt class="col-sm-5">Mã đơn hàng</dt>
                                <dd class="col-sm-7 fw-semibold">#@Model.OrderId</dd>

                                <dt class="col-sm-5">Số tiền thanh toán</dt>
                                <dd class="col-sm-7 fw-semibold text-success">@Model.DisplayAmount</dd>

                                @if (!string.IsNullOrWhiteSpace(Model.OrderInfo))
                                {
                                    <dt class="col-sm-5">Nội dung</dt>
                                    <dd class="col-sm-7">@Model.OrderInfo</dd>
                                }

                                @if (!string.IsNullOrWhiteSpace(Model.TransactionNo))
                                {
                                    <dt class="col-sm-5">Mã giao dịch VNPAY</dt>
                                    <dd class="col-sm-7">@Model.TransactionNo</dd>
                                }

                                @if (!string.IsNullOrWhiteSpace(Model.BankCode))
                                {
                                    <dt class="col-sm-5">Ngân hàng</dt>
                                    <dd class="col-sm-7">@Model.BankCode</dd>
                                }

                                @if (!string.IsNullOrWhiteSpace(Model.CardType))
                                {
                                    <dt class="col-sm-5">Loại thẻ</dt>
                                    <dd class="col-sm-7">@Model.CardType</dd>
                                }

                                @if (!string.IsNullOrWhiteSpace(Model.BankTranNo))
                                {
                                    <dt class="col-sm-5">Mã giao dịch ngân hàng</dt>
                                    <dd class="col-sm-7">@Model.BankTranNo</dd>
                                }

                                @if (!string.IsNullOrWhiteSpace(Model.PayDate))
                                {
                                    <dt class="col-sm-5">Thời gian thanh toán</dt>
                                    <dd class="col-sm-7">@Model.PayDate</dd>
                                }
                            </dl>
                        </div>
                    }
                    else
                    {
                        <dl class="row mb-0">
                            @if (!string.IsNullOrWhiteSpace(Model.OrderId))
                            {
                                <dt class="col-sm-5">Mã đơn hàng</dt>
                                <dd class="col-sm-7">#@Model.OrderId</dd>
                            }

                            <dt class="col-sm-5">Mã phản hồi</dt>
                            <dd class="col-sm-7">@Model.ResponseCode</dd>

                            <dt class="col-sm-5">Chữ ký hợp lệ</dt>
                            <dd class="col-sm-7">@(Model.IsSignatureValid ? "Có" : "Không")</dd>
                        </dl>
                    }

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        @if (Model.IsSuccess && int.TryParse(Model.OrderId, out var orderId))
                        {
                            var isLoggedInCustomer = Context.Session.GetString("IsAuthenticated") == "True"
                                && Context.Session.GetString("UserType") == "Customer";
                            if (isLoggedInCustomer)
                            {
                                <a asp-controller="Order" asp-action="Details" asp-route-id="@orderId" class="btn btn-success">
                                    <i class="fas fa-receipt me-1"></i> Xem đơn hàng
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Order" asp-action="Confirmation" asp-route-id="@orderId" class="btn btn-success">
                                    <i class="fas fa-receipt me-1"></i> Xem đơn hàng
                                </a>
                            }
                        }
                        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-home me-1"></i> Về trang chủ
                        </a>
                        @if (Context.Session.GetString("IsAuthenticated") == "True" && Context.Session.GetString("UserType") == "Customer")
                        {
                            <a asp-controller="Order" asp-action="MyOrders" class="btn btn-outline-primary payment-btn-outline">
                                <i class="fas fa-list me-1"></i> Đơn hàng của tôi
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .payment-summary {
        background: #111111;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 0;
    }

    .payment-summary__title {
        color: #ffffff !important;
        font-family: 'Montserrat', sans-serif;
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    .payment-summary__list dt {
        color: #b3b3b3 !important;
    }

    .payment-summary__list dd {
        color: #ffffff !important;
    }

    .crud-theme .text-success {
        color: #ffffff !important;
    }

    .crud-theme .card-body .alert-success {
        background: #111111;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-left: 2px solid #ffffff;
        color: #ffffff !important;
        border-radius: 0;
    }

    .crud-theme .card-body .alert-warning {
        background: #111111;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-left: 2px solid #b3b3b3;
        color: #ffffff !important;
        border-radius: 0;
    }

    .payment-btn-outline {
        background: transparent !important;
        color: #b3b3b3 !important;
        border: 1px solid rgba(255, 255, 255, 0.25) !important;
        border-radius: 0 !important;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-family: 'Montserrat', sans-serif;
        box-shadow: none !important;
        transition: all 0.4s ease;
    }

    .payment-btn-outline:hover {
        background: #ffffff !important;
        color: #000 !important;
        border-color: #ffffff !important;
    }
</style>
