@model ToyStore.Domain.Entities.OrderDetail

@{
    ViewData["Title"] = "Delete";
}

<div class="crud-theme">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0"><i class="fas fa-trash me-2"></i>Xác nhận xóa chi tiết đơn</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">Bạn có chắc chắn muốn xóa?</div>
                    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Quantity)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Quantity)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.UnitPrice)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.UnitPrice)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Order)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Order.OrderId)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Product)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Product.ProductId)
        </dd>
                    </dl>
                    
                    <form asp-action="Delete" class="d-inline">
                        <input type="hidden" asp-for="OrderDetailId" />
                        <button type="submit" class="btn btn-danger"><i class="fas fa-trash me-1"></i>Xóa</button>
                    </form>
                    <a asp-action="Index" class="btn btn-secondary ms-2">Quay lại</a>
                </div>
            </div>
        </div>
    </div>
</div>
