@model ToyStore.Models.CreateStaffViewModel
@{
    ViewData["Title"] = "Sửa thông tin nhân viên";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-md-10">
        <div class="card staff-card">
            <div class="card-header staff-card-header">
                <h4 class="mb-0"><i class="fas fa-user-edit me-2"></i>Sửa thông tin nhân viên</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger staff-validation-summary mb-3"></div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-4">
                                <label asp-for="FullName" class="form-label staff-form-label"></label>
                                <input asp-for="FullName" class="form-control staff-form-input" placeholder="Nhập họ tên" />
                                <span asp-validation-for="FullName" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-4">
                                <label asp-for="Username" class="form-label staff-form-label"></label>
                                <input asp-for="Username" class="form-control staff-form-input" placeholder="Nhập username" />
                                <span asp-validation-for="Username" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-4">
                                <label asp-for="Password" class="form-label staff-form-label"></label>
                                <input asp-for="Password" type="password" class="form-control staff-form-input" placeholder="Nhập mật khẩu mới" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                                <small class="staff-form-hint">Để trống nếu không muốn thay đổi mật khẩu</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-4">
                                <label asp-for="ConfirmPassword" class="form-label staff-form-label"></label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control staff-form-input" placeholder="Xác nhận mật khẩu mới" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Role" class="form-label staff-form-label"></label>
                        <select asp-for="Role" class="form-select staff-form-select">
                            <option value="Staff">Nhân viên</option>
                            <option value="Admin">Quản trị viên</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger"></span>
                    </div>

                    <hr class="staff-divider">

                    <div class="d-flex justify-content-between staff-actions">
                        <a asp-action="Index" class="btn staff-btn staff-btn-ghost">
                            <i class="fas fa-arrow-left me-2"></i>Quay lại
                        </a>
                        <button type="submit" class="btn staff-btn staff-btn-primary">
                            <i class="fas fa-save me-2"></i>Cập nhật
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<partial name="_StaffFormStyles" />

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
